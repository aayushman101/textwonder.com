---
import {
  t, sectionsForLocale, sectionPath, sectionMeta,
  toolsForLocale, toolPath, homePath, SECTION_BRANDS,
} from '../i18n/index.js';
import { FEATURED_TOOLS } from '../data/categories.js';

const { locale } = Astro.props;

const sections = sectionsForLocale(locale).map((key) => ({
  key,
  path: sectionPath(locale, key),
  name: sectionMeta(locale, key).name,
  icon: SECTION_BRANDS[key].icon,
}));

// Same curated shortlist as the English footer, but only entries that are
// actually translated — a footer link reading "EMI Calculator" on a Spanish
// page would undo the localization. Any shortfall is topped up with other
// translated tools so the column always holds six native names.
const translatedTools = sectionsForLocale(locale).flatMap((key) =>
  toolsForLocale(locale, key).filter((tool) => tool.translated).map((tool) => ({ ...tool, key })),
);

const shortlist = FEATURED_TOOLS
  .map((f) => translatedTools.find((tool) => tool.key === f.section && tool.slug === f.slug))
  .filter(Boolean);

// Top up from a section not already represented, so the column stays spread
// across categories rather than filling up with a second text tool.
const seen = new Set(shortlist.map((tool) => `${tool.key}:${tool.slug}`));
const covered = new Set(shortlist.map((tool) => tool.key));
const remaining = translatedTools.filter((tool) => !seen.has(`${tool.key}:${tool.slug}`));
const topUp = [
  ...remaining.filter((tool) => !covered.has(tool.key)),
  ...remaining.filter((tool) => covered.has(tool.key)),
];
const popularTools = [...shortlist, ...topUp].slice(0, 6);
---

<footer class="border-t border-slate-800 bg-[var(--bg-base)] mt-16">
  <div class="bg-[var(--bg-surface)] border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row items-center gap-2 text-center sm:text-start">
      <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <p class="text-sm text-slate-400">
        <strong class="text-emerald-400">{t(locale, 'footer.privacyLabel')}</strong> {t(locale, 'footer.privacyText')}
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
      <div>
        <a href={homePath(locale)} class="text-xl font-bold text-white" style="font-family: 'Space Grotesk', sans-serif;">
          Text<span class="text-violet-500">Wonder</span>
        </a>
        <p class="text-slate-400 text-sm mt-2 leading-relaxed">{t(locale, 'footer.brandDesc')}</p>
      </div>

      <div>
        <h3 class="text-white font-semibold text-sm mb-3">{t(locale, 'footer.categories')}</h3>
        <ul class="space-y-2">
          {sections.map((s) => (
            <li>
              <a href={s.path} class="text-slate-400 hover:text-violet-400 text-sm transition-colors">
                {s.icon} {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold text-sm mb-3">{t(locale, 'footer.popular')}</h3>
        <ul class="space-y-2">
          {popularTools.map((tool) => (
            <li>
              <a href={toolPath(locale, tool.key, tool.slug)} class="text-slate-400 hover:text-violet-400 text-sm transition-colors">
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold text-sm mb-3">{t(locale, 'footer.company')}</h3>
        <ul class="space-y-2">
          <li><a href="/about/" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">{t(locale, 'footer.about')}</a></li>
          <li><a href="/contact/" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">{t(locale, 'footer.contact')}</a></li>
          <li><a href="/blog/" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">{t(locale, 'nav.blog')}</a></li>
        </ul>
        <!-- The legal pages exist only in English, so their labels stay in
             English too — a translated label pointing at English copy would
             promise more than the page delivers. -->
        <h3 class="text-white font-semibold text-sm mt-5 mb-3">Legal</h3>
        <ul class="space-y-2">
          <li><a href="/privacy-policy/" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">{t(locale, 'footer.privacy')}</a></li>
          <li><a href="/cookie-policy/" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">Cookie Policy</a></li>
          <li><a href="/terms/" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">Terms of Service</a></li>
          <li><a href="/disclaimer/" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">Disclaimer</a></li>
        </ul>
        <h3 class="text-white font-semibold text-sm mt-5 mb-3">{t(locale, 'footer.otherSites')}</h3>
        <ul class="space-y-2">
          <li><a href="https://aaobanao.com" target="_blank" rel="noopener" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">AaoBanao.com</a></li>
          <li><a href="https://toolswonder.com" target="_blank" rel="noopener" class="text-slate-400 hover:text-violet-400 text-sm transition-colors">ToolsWonder.com</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-slate-500 text-sm">© {new Date().getFullYear()} TextWonder. {t(locale, 'footer.rights')}</p>
      <p class="text-slate-500 text-sm">{t(locale, 'footer.made')}</p>
    </div>
  </div>
</footer>
