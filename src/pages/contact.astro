---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact TextWonder — Get In Touch"
  description="Have feedback, found a bug, or want to suggest a tool? Contact TextWonder directly. We read and respond to every message."
  canonical="/contact"
>
  <Header />

  <main class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-white mb-2" style="font-family: 'Space Grotesk', sans-serif;">Get In Touch</h1>
    <p class="text-slate-500 text-sm mb-8">We'd love to hear from you</p>

    <div class="space-y-8">
      <!-- Contact Methods -->
      <section class="space-y-6">
        <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-6">
          <h2 class="text-white font-semibold text-xl mb-2">Email</h2>
          <p class="text-slate-400 mb-3">The fastest way to reach us. We read every message.</p>
          <a href="mailto:hello@textwonder.com" class="inline-block px-6 py-2.5 rounded-lg text-white font-semibold" style="background:#7c3aed; hover:opacity:0.9;">
            hello@textwonder.com
          </a>
        </div>

        <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-6">
          <h2 class="text-white font-semibold text-xl mb-2">GitHub</h2>
          <p class="text-slate-400 mb-3">Report bugs or suggest features by opening an issue on GitHub.</p>
          <a href="https://github.com/aayushman101/textwonder.com" target="_blank" rel="noopener" class="inline-block px-6 py-2.5 rounded-lg text-white font-semibold" style="background:#7c3aed; hover:opacity:0.9;">
            View on GitHub
          </a>
        </div>

        <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-6">
          <h2 class="text-white font-semibold text-xl mb-2">Social Media</h2>
          <p class="text-slate-400 mb-3">Follow us or send a message on social platforms.</p>
          <div class="flex gap-3">
            <a href="https://twitter.com/textwonder" target="_blank" rel="noopener" class="text-slate-400 hover:text-violet-400 transition-colors">Twitter</a>
            <span class="text-slate-600">•</span>
            <a href="https://github.com/aayushman101" target="_blank" rel="noopener" class="text-slate-400 hover:text-violet-400 transition-colors">GitHub</a>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-6">
        <h2 class="text-white font-semibold text-xl mb-4">Common Questions</h2>
        <div class="space-y-6">
          <div>
            <h3 class="text-white font-medium mb-1">How long does it take to get a response?</h3>
            <p class="text-slate-400">We try to respond within 24-48 hours during weekdays. Sometimes we're slower, but we read everything.</p>
          </div>

          <div>
            <h3 class="text-white font-medium mb-1">How do I report a bug?</h3>
            <p class="text-slate-400">Email us with details: which tool, what you were doing, what went wrong, and your browser. Or open an issue on GitHub for technical details.</p>
          </div>

          <div>
            <h3 class="text-white font-medium mb-1">Can I suggest a new tool?</h3>
            <p class="text-slate-400">Absolutely! Tell us what tool you'd like to see and what problem it would solve. We get thousands of suggestions and build the ones that help the most people.</p>
          </div>

          <div>
            <h3 class="text-white font-medium mb-1">Do you accept partnerships or sponsorships?</h3>
            <p class="text-slate-400">We're open to conversations. Email us to discuss partnership opportunities.</p>
          </div>

          <div>
            <h3 class="text-white font-medium mb-1">Can I use TextWonder in my app or website?</h3>
            <p class="text-slate-400">The code is open-source on GitHub. Check the license and reach out if you have integration questions.</p>
          </div>

          <div>
            <h3 class="text-white font-medium mb-1">Is there a privacy or data concern I should know?</h3>
            <p class="text-slate-400">Nope. Everything runs in your browser. We don't collect, store, or transmit your data. Check our <a href="/privacy-policy" class="text-violet-400 hover:text-violet-300">Privacy Policy</a> for details.</p>
          </div>
        </div>
      </section>

      <!-- Response Times -->
      <section class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-6">
        <h2 class="text-white font-semibold text-xl mb-3">What We're Looking For</h2>
        <ul class="space-y-2 text-slate-400">
          <li>✅ Bug reports with browser/OS info</li>
          <li>✅ Feature suggestions that solve real problems</li>
          <li>✅ Feedback on tools you use</li>
          <li>✅ Ideas for new tool categories</li>
          <li>✅ Accessibility issues</li>
          <li>✅ Performance complaints</li>
        </ul>
      </section>

      <!-- CTA -->
      <section class="text-center">
        <p class="text-slate-400 mb-4">Ready to reach out?</p>
        <a href="mailto:hello@textwonder.com" class="inline-block px-8 py-3 rounded-lg text-white font-semibold text-lg" style="background:#7c3aed; hover:opacity:0.9;">
          Send us an email
        </a>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
