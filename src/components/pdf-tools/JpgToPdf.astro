---
// Image → PDF.
//
// Two things the previous version got wrong, both worth naming because they
// are the same mistakes the competition makes:
//
// 1. WebP was advertised and could not work. Non-JPEG bytes were handed to
//    pdf-lib's embedPng, which parses a PNG signature and throws. Everything
//    now decodes through createImageBitmap first, so whatever the browser can
//    read (WebP, AVIF, GIF, BMP, HEIC on Safari) becomes a page.
//
// 2. EXIF orientation was ignored, so portrait phone photos came out sideways.
//    `imageOrientation: 'from-image'` applies the EXIF transform at decode
//    time. iLovePDF and Smallpdf both get this wrong on some files; it is the
//    single most common complaint about tools in this category.
---

<div class="space-y-5" id="jtp-root">
  <!-- Drop zone -->
  <div id="jtp-drop" class="border-2 border-dashed border-slate-700 hover:border-orange-500/60 rounded-xl p-8 text-center cursor-pointer transition-colors">
    <input type="file" id="jtp-file" accept="image/*,.heic,.heif" multiple class="hidden" />
    <div class="text-4xl mb-2">📷</div>
    <p class="text-slate-300 font-medium mb-1">Drop images here or click to select</p>
    <p class="text-slate-500 text-sm">JPG, PNG, WebP, AVIF, GIF, BMP · each image becomes one page</p>
  </div>

  <!-- Work area: preview on the left, controls pinned on the right.
       With a large batch the controls used to sit below every thumbnail, so
       Convert was several screens down. The sidebar sticks to the viewport
       instead, which is the pattern iLovePDF and Smallpdf both use.
       Below `lg` it collapses back to a single column. -->
  <div id="jtp-work" class="hidden">
  <div class="min-w-0 space-y-4">
  <!-- Toolbar -->
  <div id="jtp-toolbar" class="hidden flex-wrap items-center gap-2">
    <span id="jtp-count" class="text-sm text-slate-400 mr-1"></span>
    <button id="jtp-add" class="jtp-btn">+ Add more</button>
    <div class="relative">
      <button id="jtp-sort-btn" class="jtp-btn">Sort ▾</button>
      <div id="jtp-sort-menu" class="hidden absolute z-20 mt-1 w-52 bg-[var(--bg-surface)] border border-slate-700 rounded-lg shadow-xl py-1">
        <button data-sort="name-asc"  class="jtp-menu">Name A → Z</button>
        <button data-sort="name-desc" class="jtp-menu">Name Z → A</button>
        <button data-sort="natural"   class="jtp-menu">Name, numbers in order</button>
        <button data-sort="size-asc"  class="jtp-menu">Size, smallest first</button>
        <button data-sort="size-desc" class="jtp-menu">Size, largest first</button>
        <button data-sort="date-asc"  class="jtp-menu">Date modified</button>
        <button data-sort="reverse"   class="jtp-menu">Reverse current order</button>
      </div>
    </div>
    <span class="w-px h-5 bg-slate-700 mx-1"></span>
    <button id="jtp-selall" class="jtp-btn">Select all</button>
    <button id="jtp-rotl" class="jtp-btn" title="Rotate selected left">⟲</button>
    <button id="jtp-rotr" class="jtp-btn" title="Rotate selected right">⟳</button>
    <button id="jtp-del" class="jtp-btn jtp-danger">Delete selected</button>
    <span class="w-px h-5 bg-slate-700 mx-1"></span>
    <button id="jtp-undo" class="jtp-btn" disabled>↩ Undo</button>
  </div>

  <!-- Thumbnail grid -->
  <!-- `grid` is added by JS, not here: it and `hidden` both set `display`, so
       having both in the static class list makes the resolved value depend on
       Tailwind's output order rather than on state. -->
  <div id="jtp-grid" class="hidden gap-3"></div>
  </div><!-- /left pane -->

  <!-- Controls -->
  <aside id="jtp-side" class="mt-5 lg:mt-0 space-y-4">
  <div id="jtp-opts" class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-4 space-y-3">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
      <label class="block">
        <span class="jtp-lbl">Page size</span>
        <select id="jtp-size" class="jtp-inp">
          <option value="a4">A4 — 210 × 297 mm</option>
          <option value="letter">Letter — 8.5 × 11 in</option>
          <option value="legal">Legal — 8.5 × 14 in</option>
          <option value="a3">A3 — 297 × 420 mm</option>
          <option value="a5">A5 — 148 × 210 mm</option>
          <option value="fit">Fit page to image</option>
        </select>
      </label>
      <label class="block">
        <span class="jtp-lbl">Orientation</span>
        <select id="jtp-orient" class="jtp-inp">
          <option value="auto">Auto (match image)</option>
          <option value="portrait">Portrait</option>
          <option value="landscape">Landscape</option>
        </select>
      </label>
      <label class="block">
        <span class="jtp-lbl">Margin</span>
        <select id="jtp-margin" class="jtp-inp">
          <option value="0">None</option>
          <option value="18">Small (6 mm)</option>
          <option value="36">Medium (13 mm)</option>
          <option value="72">Large (25 mm)</option>
        </select>
      </label>
      <label class="block">
        <span class="jtp-lbl">Image fit</span>
        <select id="jtp-fit" class="jtp-inp">
          <option value="contain">Fit (whole image)</option>
          <option value="cover">Fill (crop to edges)</option>
          <option value="actual">Actual size</option>
          <option value="stretch">Stretch (distorts)</option>
        </select>
      </label>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
      <label class="block">
        <span class="jtp-lbl">Quality</span>
        <select id="jtp-quality" class="jtp-inp">
          <option value="original">Original (no re-encode)</option>
          <option value="0.92" selected>High</option>
          <option value="0.8">Medium</option>
          <option value="0.6">Small (most compression)</option>
        </select>
      </label>
      <label class="block">
        <span class="jtp-lbl">Output file name</span>
        <input id="jtp-name" type="text" value="images" class="jtp-inp" />
      </label>
      <label class="flex items-center gap-2 self-end lg:pb-0 pb-2">
        <input id="jtp-pagenums" type="checkbox" class="accent-orange-500 w-4 h-4 shrink-0" />
        <span class="text-sm text-slate-300">Add page numbers</span>
      </label>
      <label class="flex items-center gap-2 self-end lg:pb-0 pb-2">
        <input id="jtp-separate" type="checkbox" class="accent-orange-500 w-4 h-4 shrink-0" />
        <span class="text-sm text-slate-300">One PDF per image</span>
      </label>
    </div>
  </div>

  <!-- Actions. `sticky bottom-0` keeps Convert reachable on a phone once the
       thumbnail list is longer than the screen; on `lg` it is already inside
       the pinned sidebar so the sticky offset does nothing. -->
  <div id="jtp-actions" class="sticky bottom-0 z-10 bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-4 space-y-3">
    <button id="jtp-convert" class="w-full px-6 py-2.5 bg-orange-600 hover:bg-orange-500 text-white rounded-lg text-sm font-medium transition-colors">Convert to PDF</button>
    <div class="flex items-center justify-between gap-2">
      <button id="jtp-clear" class="px-3 py-1.5 hover:bg-[var(--bg-surface-hover)] text-slate-400 rounded-lg text-xs border border-slate-700 transition-colors">Clear all</button>
      <span id="jtp-est" class="text-xs text-slate-500 text-right"></span>
    </div>

    <div id="jtp-bar" class="hidden h-1.5 bg-slate-800 rounded-full overflow-hidden">
      <div id="jtp-bar-fill" class="h-full bg-orange-500 transition-all" style="width:0%"></div>
    </div>

    <div id="jtp-status" class="hidden text-sm"></div>
  </div>
  </aside><!-- /controls -->
  </div><!-- /work -->
</div>

<style>
  /* Colours come from variables rather than literals so they follow the theme.
     The site flips --bg-* on [data-theme="light"] but has no override for
     component-local classes, so hardcoding slate text here left the controls
     as pale grey on white in light mode. */
  #jtp-root {
    --jtp-text: rgb(203 213 225);
    --jtp-text-strong: #ffffff;
    --jtp-text-dim: rgb(148 163 184);
    --jtp-border: rgb(51 65 85);
    /* Chips sit on top of the thumbnail, so they need their own translucent
       backing rather than the panel surface. */
    --jtp-chip-bg: rgba(15, 23, 42, .82);
    --jtp-chip-text: #e2e8f0;
    --jtp-chip-border: rgba(148, 163, 184, .28);
  }
  :global([data-theme="light"]) #jtp-root {
    --jtp-text: #334155;
    --jtp-text-strong: #0f172a;
    --jtp-text-dim: #64748b;
    --jtp-border: #cbd5e1;
    --jtp-chip-bg: rgba(255, 255, 255, .92);
    --jtp-chip-text: #0f172a;
    --jtp-chip-border: rgba(15, 23, 42, .14);
  }

  /* Overlay controls. PDFWonder's accent is orange, so the page-order badge
     carries it and the icon buttons adopt it on hover; remove goes red.
     `:global` for the same reason as the card rules — these elements are
     built in JS and never receive Astro's scoping attribute. */
  :global(.jtp-badge) {
    position: absolute; top: .375rem; left: .375rem;
    min-width: 1.25rem; padding: 0 .3rem;
    font-size: .6875rem; line-height: 1.25rem; font-weight: 600;
    text-align: center; border-radius: .3rem;
    /* orange-700, not the orange-600 used for the Convert button: white on
       600 measures 3.56:1, under the 4.5:1 needed for text this size. 700
       keeps the accent and reaches 5.18:1. */
    background: #c2410c; color: #fff;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .35);
  }
  :global(.jtp-iconbtn) {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.5rem; height: 1.5rem; font-size: .75rem; border-radius: .3rem;
    background: var(--jtp-chip-bg); color: var(--jtp-chip-text);
    border: 1px solid var(--jtp-chip-border);
    backdrop-filter: blur(2px);
    transition: background-color .15s, color .15s, border-color .15s;
  }
  :global(.jtp-iconbtn:hover) { background: #ea580c; color: #fff; border-color: #ea580c; }
  :global(.jtp-iconbtn-danger:hover) { background: #dc2626; color: #fff; border-color: #dc2626; }

  .jtp-btn {
    padding: 0.4rem 0.7rem; font-size: 0.8125rem; border-radius: 0.5rem;
    background: var(--bg-surface); border: 1px solid var(--jtp-border);
    color: var(--jtp-text); transition: all .15s;
  }
  .jtp-btn:hover:not(:disabled) { background: var(--bg-surface-hover); color: var(--jtp-text-strong); }
  .jtp-btn:disabled { opacity: .4; cursor: not-allowed; }
  .jtp-danger:hover:not(:disabled) { color: #dc2626; border-color: #dc2626; }
  .jtp-menu {
    display: block; width: 100%; text-align: left; padding: .45rem .8rem;
    font-size: .8125rem; color: var(--jtp-text);
  }
  .jtp-menu:hover { background: var(--bg-surface-hover); color: var(--jtp-text-strong); }
  .jtp-lbl { display: block; font-size: .75rem; color: var(--jtp-text-dim); margin-bottom: .2rem; }
  .jtp-inp {
    width: 100%; padding: .45rem .6rem; font-size: .8125rem; border-radius: .5rem;
    background: var(--bg-base); border: 1px solid var(--jtp-border);
    color: var(--jtp-text-strong);
  }
  .jtp-inp:focus { outline: none; border-color: #f97316; }
  .jtp-inp option { background: var(--bg-surface); color: var(--jtp-text-strong); }
  /* Two-pane work area. Driven from CSS rather than Tailwind display classes
     because `hidden` and `grid` both set `display`, and which one wins would
     otherwise depend on stylesheet order instead of on state. */
  #jtp-work:not(.hidden) { display: block; }
  @media (min-width: 1024px) {
    #jtp-work:not(.hidden) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 1.5rem;
      align-items: start;
    }
    /* No inner scrolling: every control is visible at once. The panel is
       compact enough to fit alongside the canvas, so capping its height and
       scrolling it only ever hid options behind a scrollbar. */
    #jtp-side { position: sticky; top: 1rem; }
  }

  /* Sticky only when the viewport is tall enough to hold the whole panel.
     A sticky element taller than the screen pins at the top and leaves its
     bottom permanently out of reach, so on short windows it scrolls with the
     page instead. */
  @media (min-width: 1024px) and (max-height: 700px) {
    #jtp-side { position: static; }
  }

  /* Thumbnail size grows with the viewport. A fixed 140px minimum left the
     cards looking like stamps once the layout went full width, so the floor
     steps up on larger screens instead of just adding more columns. */
  #jtp-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  @media (min-width: 1024px) { #jtp-grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); } }
  @media (min-width: 1536px) { #jtp-grid { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); } }

  /* `:global` is required here, not decorative. Astro scopes component styles
     by appending a data-astro-cid attribute to the selector, and it can only
     stamp that attribute on elements it renders. The cards are built in JS
     with innerHTML, so they never carry it — every unscoped .jtp-card rule
     below silently matched nothing, which is why the cards had no rounded
     corners, no grab cursor and no drag dimming. Elements that exist in the
     template (#jtp-grid, .jtp-btn, .jtp-inp) do not need this. */
  :global(.jtp-card) { position: relative; border-radius: .6rem; overflow: hidden; cursor: grab; }
  :global(.jtp-card:active) { cursor: grabbing; }
  :global(.jtp-card.dragging) { opacity: .35; }

  /* Insertion marker: a bar on the edge the item will land against, rather
     than a box around the card it happens to be hovering. */
  :global(.jtp-card.over-before)::before,
  :global(.jtp-card.over-after)::after {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: #f97316;
    border-radius: 2px;
    z-index: 5;
  }
  /* Inside the card, not outside it: the card sets `overflow: hidden` for its
     rounded corners, which was clipping a marker positioned at -2px. */
  :global(.jtp-card.over-before)::before { left: 0; }
  :global(.jtp-card.over-after)::after { right: 0; }
</style>

<script is:inline>
(function () {
  const $ = (id) => document.getElementById(id);
  const drop = $('jtp-drop'), fileInput = $('jtp-file'), grid = $('jtp-grid');
  const toolbar = $('jtp-toolbar'), work = $('jtp-work');
  const status = $('jtp-status'), bar = $('jtp-bar'), barFill = $('jtp-bar-fill');

  // Points, at 72 per inch.
  const SIZES = {
    a4:     [595.28, 841.89],
    letter: [612, 792],
    legal:  [612, 1008],
    a3:     [841.89, 1190.55],
    a5:     [419.53, 595.28],
  };
  const RASTER_DPI = 150;   // enough for print, well short of absurd file sizes

  let items = [];           // { id, file, name, w, h, rot, sel, thumb }
  let history = [];         // snapshots for undo
  let seq = 0;

  // ── state helpers ────────────────────────────────────────────────────────
  function snapshot() {
    history.push(items.map((it) => ({ ...it })));
    if (history.length > 30) history.shift();
    $('jtp-undo').disabled = false;
  }
  function undo() {
    if (!history.length) return;
    items = history.pop();
    $('jtp-undo').disabled = !history.length;
    render();
  }

  // ── loading ──────────────────────────────────────────────────────────────
  drop.addEventListener('click', () => fileInput.click());
  $('jtp-add').addEventListener('click', () => fileInput.click());
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('border-orange-500'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('border-orange-500'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault(); drop.classList.remove('border-orange-500');
    addFiles([...e.dataTransfer.files]);
  });
  fileInput.addEventListener('change', () => { addFiles([...fileInput.files]); fileInput.value = ''; });

  async function addFiles(files) {
    const imgs = files.filter((f) => f.type.startsWith('image/') || /\.(heic|heif)$/i.test(f.name));
    if (!imgs.length) return;
    if (items.length) snapshot();
    showStatus(`Reading ${imgs.length} image${imgs.length !== 1 ? 's' : ''}…`, 'info');

    let failed = 0;
    for (const file of imgs) {
      try {
        // EXIF-aware decode. Also the reason WebP/AVIF/GIF/BMP/HEIC work at
        // all — pdf-lib itself only understands JPEG and PNG.
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
        items.push({
          id: ++seq, file, name: file.name,
          w: bmp.width, h: bmp.height, rot: 0, sel: false,
          thumb: thumbOf(bmp),
        });
        bmp.close();
      } catch (err) {
        failed++;
      }
    }
    render();
    if (failed) showStatus(`${failed} file${failed !== 1 ? 's' : ''} could not be read and were skipped.`, 'error');
    else hideStatus();
  }

  function thumbOf(bmp) {
    const max = 260;
    const s = Math.min(max / bmp.width, max / bmp.height, 1);
    const c = document.createElement('canvas');
    c.width = Math.max(1, Math.round(bmp.width * s));
    c.height = Math.max(1, Math.round(bmp.height * s));
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.7);
  }

  // ── rendering ────────────────────────────────────────────────────────────
  function render() {
    const has = items.length > 0;
    work.classList.toggle('hidden', !has);
    [toolbar, grid].forEach((el) => el.classList.toggle('hidden', !has));
    toolbar.classList.toggle('flex', has);
    grid.classList.toggle('grid', has);
    if (!has) { drop.classList.remove('hidden'); return; }
    drop.classList.add('hidden');

    const selCount = items.filter((i) => i.sel).length;
    $('jtp-count').textContent = `${items.length} image${items.length !== 1 ? 's' : ''}` +
      (selCount ? ` · ${selCount} selected` : '');
    ['jtp-rotl', 'jtp-rotr', 'jtp-del'].forEach((id) => { $(id).disabled = selCount === 0; });
    $('jtp-selall').textContent = selCount === items.length ? 'Clear selection' : 'Select all';

    grid.innerHTML = items.map((it, i) => `
      <div class="jtp-card bg-[var(--bg-surface)] border ${it.sel ? 'border-orange-500' : 'border-slate-800'}"
           draggable="true" data-i="${i}">
        <div class="aspect-square flex items-center justify-center bg-[var(--bg-base)] overflow-hidden">
          <img src="${it.thumb}" alt="" class="max-w-full max-h-full object-contain pointer-events-none"
               style="transform:rotate(${it.rot}deg)" />
        </div>
        <div class="jtp-badge">${i + 1}</div>
        <label class="absolute top-1.5 right-1.5 leading-none">
          <input type="checkbox" data-sel="${i}" ${it.sel ? 'checked' : ''} class="accent-orange-500 w-4 h-4 align-top" />
        </label>
        <div class="absolute bottom-8 right-1.5 flex gap-1">
          <button data-rot="${i}" class="jtp-iconbtn" title="Rotate right">⟳</button>
          <button data-rm="${i}" class="jtp-iconbtn jtp-iconbtn-danger" title="Remove">✕</button>
        </div>
        <div class="px-2 py-1.5 border-t border-slate-800">
          <p class="text-[11px] text-slate-400 truncate" title="${esc(it.name)}">${esc(it.name)}</p>
          <p class="text-[10px] text-slate-600">${dims(it)} · ${(it.file.size / 1024).toFixed(0)} KB</p>
        </div>
      </div>`).join('');

    estimate();
  }

  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const dims = (it) => (it.rot % 180 ? `${it.h}×${it.w}` : `${it.w}×${it.h}`);

  // Delegated grid events
  grid.addEventListener('click', (e) => {
    const rot = e.target.closest('[data-rot]'), rm = e.target.closest('[data-rm]');
    if (rot) { snapshot(); const i = +rot.dataset.rot; items[i].rot = (items[i].rot + 90) % 360; render(); }
    else if (rm) { snapshot(); items.splice(+rm.dataset.rm, 1); render(); }
  });
  grid.addEventListener('change', (e) => {
    const cb = e.target.closest('[data-sel]');
    if (cb) { items[+cb.dataset.sel].sel = cb.checked; render(); }
  });

  // Drag to reorder.
  //
  // The browser snapshots the drag source *after* the dragstart handler
  // returns, so dimming the card inside that handler bakes the dimming into
  // the ghost — which is what made the dragged page look washed out. The
  // class is therefore deferred a frame, and setDragImage pins the ghost to
  // the card under the cursor so the browser never falls back to snapshotting
  // a larger ancestor.
  let dragFrom = null;
  grid.addEventListener('dragstart', (e) => {
    const card = e.target.closest('.jtp-card'); if (!card) return;
    dragFrom = +card.dataset.i;
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', String(dragFrom));  // Firefox needs data present
    const r = card.getBoundingClientRect();
    e.dataTransfer.setDragImage(card, e.clientX - r.left, e.clientY - r.top);
    requestAnimationFrame(() => card.classList.add('dragging'));
  });
  grid.addEventListener('dragend', clearDrag);
  function clearDrag() {
    dragFrom = null;
    grid.querySelectorAll('.jtp-card').forEach((c) =>
      c.classList.remove('dragging', 'over-before', 'over-after'));
  }
  grid.addEventListener('dragover', (e) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    const card = e.target.closest('.jtp-card');
    if (!card || dragFrom === null) return;
    // Which half of the card the cursor is over decides whether the item lands
    // before or after it, so the marker shows the real insertion point rather
    // than just highlighting a target.
    const r = card.getBoundingClientRect();
    const after = (e.clientX - r.left) > r.width / 2;
    grid.querySelectorAll('.jtp-card').forEach((c) => c.classList.remove('over-before', 'over-after'));
    if (+card.dataset.i !== dragFrom) card.classList.add(after ? 'over-after' : 'over-before');
  });
  grid.addEventListener('dragleave', (e) => {
    if (!grid.contains(e.relatedTarget)) {
      grid.querySelectorAll('.jtp-card').forEach((c) => c.classList.remove('over-before', 'over-after'));
    }
  });
  grid.addEventListener('drop', (e) => {
    e.preventDefault();
    const card = e.target.closest('.jtp-card');
    if (!card || dragFrom === null) { clearDrag(); return; }
    const over = +card.dataset.i;
    const r = card.getBoundingClientRect();
    const after = (e.clientX - r.left) > r.width / 2;
    let to = after ? over + 1 : over;
    if (dragFrom < to) to--;             // removing the source shifts later indices left
    if (to === dragFrom) { clearDrag(); return; }
    snapshot();
    items.splice(to, 0, items.splice(dragFrom, 1)[0]);
    clearDrag();
    render();
  });

  // ── toolbar ──────────────────────────────────────────────────────────────
  $('jtp-selall').addEventListener('click', () => {
    const all = items.every((i) => i.sel);
    items.forEach((i) => { i.sel = !all; });
    render();
  });
  $('jtp-rotl').addEventListener('click', () => rotateSel(-90));
  $('jtp-rotr').addEventListener('click', () => rotateSel(90));
  function rotateSel(d) {
    snapshot();
    items.forEach((i) => { if (i.sel) i.rot = ((i.rot + d) % 360 + 360) % 360; });
    render();
  }
  $('jtp-del').addEventListener('click', () => {
    snapshot(); items = items.filter((i) => !i.sel); render();
  });
  $('jtp-undo').addEventListener('click', undo);

  const sortBtn = $('jtp-sort-btn'), sortMenu = $('jtp-sort-menu');
  sortBtn.addEventListener('click', (e) => { e.stopPropagation(); sortMenu.classList.toggle('hidden'); });
  document.addEventListener('click', () => sortMenu.classList.add('hidden'));
  sortMenu.addEventListener('click', (e) => {
    const b = e.target.closest('[data-sort]'); if (!b) return;
    snapshot();
    const k = b.dataset.sort;
    const coll = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
    if (k === 'name-asc') items.sort((a, b2) => a.name.localeCompare(b2.name));
    else if (k === 'name-desc') items.sort((a, b2) => b2.name.localeCompare(a.name));
    else if (k === 'natural') items.sort((a, b2) => coll.compare(a.name, b2.name));
    else if (k === 'size-asc') items.sort((a, b2) => a.file.size - b2.file.size);
    else if (k === 'size-desc') items.sort((a, b2) => b2.file.size - a.file.size);
    else if (k === 'date-asc') items.sort((a, b2) => a.file.lastModified - b2.file.lastModified);
    else if (k === 'reverse') items.reverse();
    sortMenu.classList.add('hidden');
    render();
  });

  $('jtp-clear').addEventListener('click', () => {
    items = []; history = []; $('jtp-undo').disabled = true;
    render(); hideStatus(); bar.classList.add('hidden');
  });

  ['jtp-size', 'jtp-orient', 'jtp-margin', 'jtp-fit', 'jtp-quality', 'jtp-separate']
    .forEach((id) => $(id).addEventListener('change', estimate));

  // ── geometry ─────────────────────────────────────────────────────────────
  // Returns the page box and the rect the image occupies inside it.
  function layout(it) {
    const sizeKey = $('jtp-size').value;
    const orient = $('jtp-orient').value;
    const margin = +$('jtp-margin').value;
    const fit = $('jtp-fit').value;

    // Rotation of 90 or 270 swaps the effective image dimensions.
    const iw = it.rot % 180 ? it.h : it.w;
    const ih = it.rot % 180 ? it.w : it.h;

    let pw, ph;
    if (sizeKey === 'fit') {
      // Page follows the image, at 72dpi, plus the margin on each side.
      pw = iw * 0.72 + margin * 2;
      ph = ih * 0.72 + margin * 2;
    } else {
      [pw, ph] = SIZES[sizeKey];
      const wantLandscape = orient === 'landscape' || (orient === 'auto' && iw > ih);
      if (wantLandscape) [pw, ph] = [ph, pw];
    }

    const cw = Math.max(1, pw - margin * 2);
    const ch = Math.max(1, ph - margin * 2);

    let dw, dh;
    if (fit === 'stretch') { dw = cw; dh = ch; }
    else if (fit === 'actual') {
      const s = Math.min(cw / (iw * 0.72), ch / (ih * 0.72), 1);  // never scale up
      dw = iw * 0.72 * s; dh = ih * 0.72 * s;
    } else {
      const s = fit === 'cover'
        ? Math.max(cw / iw, ch / ih)
        : Math.min(cw / iw, ch / ih);
      dw = iw * s; dh = ih * s;
    }

    return {
      pw, ph, cw, ch, margin, fit,
      x: margin + (cw - dw) / 2,
      y: margin + (ch - dh) / 2,
      dw, dh,
    };
  }

  // ── estimate ─────────────────────────────────────────────────────────────
  function estimate() {
    if (!items.length) { $('jtp-est').textContent = ''; return; }
    const q = $('jtp-quality').value;
    let bytes = 0;
    for (const it of items) {
      if (q === 'original') { bytes += it.file.size; continue; }
      const L = layout(it);
      // Rasterised pixel count at RASTER_DPI, then a rough bytes-per-pixel for
      // JPEG at this quality. Deliberately approximate — it is a hint, not a
      // promise, and it is labelled as one.
      const px = (L.dw / 72 * RASTER_DPI) * (L.dh / 72 * RASTER_DPI);
      bytes += px * (0.10 + (+q - 0.6) * 0.22);
    }
    bytes += 2000 + items.length * 400;
    const sep = $('jtp-separate').checked;
    $('jtp-est').textContent = `≈ ${fmt(bytes)} ${sep ? `across ${items.length} files` : 'total'} (estimate)`;
  }
  const fmt = (b) => b > 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB';

  // ── convert ──────────────────────────────────────────────────────────────
  $('jtp-convert').addEventListener('click', async () => {
    if (!items.length) return;
    const btn = $('jtp-convert');
    btn.disabled = true;
    bar.classList.remove('hidden');
    try {
      showStatus('Loading PDF engine…', 'info');
      await loadPdfLib();
      const { PDFDocument, rgb, StandardFonts } = window.PDFLib;

      const separate = $('jtp-separate').checked;
      const wantNums = $('jtp-pagenums').checked;
      const base = ($('jtp-name').value || 'images').replace(/[\\/:*?"<>|]/g, '').trim() || 'images';

      const docs = [];
      let doc = null, font = null;
      if (!separate) { doc = await PDFDocument.create(); if (wantNums) font = await doc.embedFont(StandardFonts.Helvetica); }

      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        showStatus(`Rendering page ${i + 1} of ${items.length}…`, 'info');
        barFill.style.width = ((i / items.length) * 100).toFixed(0) + '%';
        await new Promise((r) => requestAnimationFrame(r));   // let the bar paint

        if (separate) { doc = await PDFDocument.create(); if (wantNums) font = await doc.embedFont(StandardFonts.Helvetica); }

        const L = layout(it);
        const { bytes, kind } = await rasterise(it, L);
        const img = kind === 'jpg' ? await doc.embedJpg(bytes) : await doc.embedPng(bytes);

        const page = doc.addPage([L.pw, L.ph]);
        if (L.fit === 'cover') {
          // Cover overflows the content box by design; clip it to the box so
          // it cannot bleed into the margin.
          page.drawRectangle({ x: L.margin, y: L.margin, width: L.cw, height: L.ch, color: rgb(1, 1, 1) });
        }
        page.drawImage(img, { x: L.x, y: L.y, width: L.dw, height: L.dh });

        if (wantNums) {
          const label = separate ? '1' : String(i + 1);
          page.drawText(label, {
            x: L.pw / 2 - 4, y: Math.max(8, L.margin / 2 - 4),
            size: 10, font, color: rgb(0.45, 0.45, 0.45),
          });
        }
        if (separate) docs.push({ doc, name: `${base}-${String(i + 1).padStart(2, '0')}.pdf` });
      }

      barFill.style.width = '100%';
      if (separate) {
        for (const d of docs) await save(await d.doc.save(), d.name);
        showStatus(`✅ ${docs.length} PDF files created and downloaded.`, 'success');
      } else {
        const out = await doc.save();
        await save(out, `${base}.pdf`);
        showStatus(`✅ PDF created — ${items.length} page${items.length !== 1 ? 's' : ''}, ${fmt(out.length)}.`, 'success');
      }
    } catch (err) {
      showStatus('Could not build the PDF: ' + (err && err.message ? err.message : err), 'error');
    } finally {
      btn.disabled = false;
      setTimeout(() => { bar.classList.add('hidden'); barFill.style.width = '0%'; }, 800);
    }
  });

  // Draw the image into the page rect at RASTER_DPI, honouring rotation and
  // cropping for 'cover'. Returns encoded bytes ready for pdf-lib.
  async function rasterise(it, L) {
    const q = $('jtp-quality').value;
    const isJpeg = it.file.type === 'image/jpeg' || /\.jpe?g$/i.test(it.name);
    const isPng = it.file.type === 'image/png' || /\.png$/i.test(it.name);

    // Untouched JPEG/PNG can go straight in — no re-encode, no quality loss.
    if (q === 'original' && it.rot === 0 && L.fit !== 'cover' && (isJpeg || isPng)) {
      return { bytes: new Uint8Array(await it.file.arrayBuffer()), kind: isJpeg ? 'jpg' : 'png' };
    }

    const bmp = await createImageBitmap(it.file, { imageOrientation: 'from-image' });
    const cw = Math.max(1, Math.round(L.dw / 72 * RASTER_DPI));
    const ch = Math.max(1, Math.round(L.dh / 72 * RASTER_DPI));
    const canvas = document.createElement('canvas');
    canvas.width = cw; canvas.height = ch;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, cw, ch);
    ctx.imageSmoothingQuality = 'high';

    // For 'cover' the source is cropped centrally to the target aspect ratio.
    let sx = 0, sy = 0, sw = bmp.width, sh = bmp.height;
    if (L.fit === 'cover') {
      const target = (it.rot % 180 ? ch / cw : cw / ch);
      const srcAspect = bmp.width / bmp.height;
      if (srcAspect > target) { sw = bmp.height * target; sx = (bmp.width - sw) / 2; }
      else { sh = bmp.width / target; sy = (bmp.height - sh) / 2; }
    }

    ctx.translate(cw / 2, ch / 2);
    ctx.rotate(it.rot * Math.PI / 180);
    // After rotating by 90/270 the drawing box swaps axes.
    const bw = it.rot % 180 ? ch : cw;
    const bh = it.rot % 180 ? cw : ch;
    ctx.drawImage(bmp, sx, sy, sw, sh, -bw / 2, -bh / 2, bw, bh);
    bmp.close();

    const quality = q === 'original' ? 0.95 : +q;
    const blob = await new Promise((r) => canvas.toBlob(r, 'image/jpeg', quality));
    return { bytes: new Uint8Array(await blob.arrayBuffer()), kind: 'jpg' };
  }

  async function save(bytes, filename) {
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename; a.click();
    await new Promise((r) => setTimeout(r, 120));
    URL.revokeObjectURL(url);
  }

  function showStatus(msg, type) {
    status.textContent = msg;
    status.className = 'text-sm py-1 ' +
      (type === 'error' ? 'text-red-400' : type === 'success' ? 'text-green-400' : 'text-slate-400');
    status.classList.remove('hidden');
  }
  const hideStatus = () => status.classList.add('hidden');

  function loadPdfLib() {
    if (window.PDFLib) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js';
      s.onload = resolve;
      s.onerror = () => reject(new Error('could not load the PDF engine — check your connection'));
      document.head.appendChild(s);
    });
  }
})();
</script>
