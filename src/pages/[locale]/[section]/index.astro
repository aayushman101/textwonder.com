---
// Localized section index (e.g. /es/herramientas-texto/). Built only for
// sections that have translated tools, and lists exactly those.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import I18nHeader from '../../../components/I18nHeader.astro';
import I18nFooter from '../../../components/I18nFooter.astro';
import {
  allLocalizedSectionRoutes, toolsForLocale, toolPath, sectionMeta,
  sectionPath, alternatesForSection, homePath, absolute, t, SECTION_BRANDS,
  LOCALES, isSectionIndexable, localizedSearchIndex,
} from '../../../i18n/index.js';

export function getStaticPaths() {
  return allLocalizedSectionRoutes();
}

const { locale, sectionKey } = Astro.props;

const meta = sectionMeta(locale, sectionKey);
const brand = SECTION_BRANDS[sectionKey];
const tools = toolsForLocale(locale, sectionKey);
const canonical = sectionPath(locale, sectionKey);
const alternates = alternatesForSection(sectionKey);

// A section whose own heading copy is still English-only is not worth
// indexing even when its tools are translated.
const indexable = isSectionIndexable(locale, sectionKey);

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.h1,
  url: absolute(canonical),
  inLanguage: LOCALES[locale].hreflang,
  description: meta.metaDescription,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: tools.length,
    itemListElement: tools.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.name,
      url: absolute(toolPath(locale, sectionKey, tool.slug)),
    })),
  },
};
---

<BaseLayout
  title={meta.metaTitle}
  description={meta.metaDescription}
  canonical={canonical}
  lang={locale}
  alternates={alternates}
  noindex={!indexable}
  searchIndex={localizedSearchIndex(locale)}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
  </Fragment>

  <I18nHeader locale={locale} alternates={alternates} />

  <main class="max-w-6xl mx-auto px-4 py-10">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500 flex flex-wrap items-center gap-1.5 mb-4">
      <a href={homePath(locale)} class="hover:text-violet-400 transition-colors">{t(locale, 'nav.home')}</a>
      <span class="text-slate-700">/</span>
      <span class="text-slate-400">{meta.name}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2" style="font-family: 'Space Grotesk', sans-serif;">
        {meta.h1}
      </h1>
      <p class="text-slate-400 text-lg">{meta.subtitle}</p>
    </div>

    <div class="relative mb-8">
      <svg class="absolute start-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="section-tool-search"
        type="text"
        placeholder={t(locale, 'section.search')}
        class="w-full bg-[var(--bg-surface)] border border-slate-700 rounded-xl ps-10 pe-4 py-3 text-slate-100 placeholder-slate-500 outline-none focus:ring-2 focus:ring-violet-600"
      />
    </div>

    <div id="section-tools-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <a
          href={toolPath(locale, sectionKey, tool.slug)}
          class="tool-card block bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-5 hover:border-slate-700 transition-colors group"
          data-name={tool.name.toLowerCase()}
        >
          <div class="flex items-center gap-2.5 mb-2">
            <span class="w-8 h-8 rounded-lg flex items-center justify-center text-base shrink-0"
              style={`background:rgba(${brand.accentRgb},0.12); border:1px solid rgba(${brand.accentRgb},0.3)`}>
              {tool.icon || brand.icon}
            </span>
            <h2 class="text-white font-semibold text-sm group-hover:text-violet-400 transition-colors">{tool.name}</h2>
          </div>
          <p class="text-slate-500 text-xs leading-relaxed">{tool.tagline}</p>
        </a>
      ))}
    </div>

    <div id="section-no-results" class="hidden text-center py-16 text-slate-500">
      {t(locale, 'section.none')}
    </div>
  </main>

  <I18nFooter locale={locale} />
</BaseLayout>

<script>
  const search = document.getElementById('section-tool-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card'));
  const noResults = document.getElementById('section-no-results');

  search?.addEventListener('input', () => {
    const q = search.value.toLowerCase().trim();
    let visible = 0;
    for (const card of cards) {
      const match = !q || (card.dataset.name || '').includes(q);
      card.classList.toggle('hidden', !match);
      if (match) visible++;
    }
    noResults?.classList.toggle('hidden', visible > 0);
  });
</script>
