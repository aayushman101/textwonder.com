---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SECTIONS, getGlobalSearchIndex } from '../data/categories.js';
import ToolMegaMenu from './ToolMegaMenu.astro';
import ToolMobileSheet from './ToolMobileSheet.astro';
import MegaMenuScript from './MegaMenuScript.astro';
import { TOOL_ICONS, SECTION_MENUS } from '../data/tool-icons.js';

interface Props {
  brand: {
    name: string;      // e.g. "CalcWonder"
    prefix: string;    // e.g. "Calc"
    suffix: string;    // e.g. "Wonder"
    rootPath: string;  // e.g. "/calc"
    accentColor: string; // e.g. "#10b981"
    idPrefix: string;  // e.g. "calc" — for unique DOM ids
  };
  tools: Array<{ slug: string; name: string }>;
}
const { brand } = Astro.props;
const toggleId = `${brand.idPrefix}-theme-toggle`;
const sunId = `${brand.idPrefix}-icon-sun`;
const moonId = `${brand.idPrefix}-icon-moon`;
const searchOpenId = `${brand.idPrefix}-search-open`;
const searchModalId = `${brand.idPrefix}-search-modal`;
const searchInputId = `${brand.idPrefix}-search-input`;
const searchResultsId = `${brand.idPrefix}-search-results`;
const searchCloseId = `${brand.idPrefix}-search-close`;
const searchBackdropId = `${brand.idPrefix}-search-backdrop`;

const categoriesWrapperId = `${brand.idPrefix}-categories-menu-wrapper`;
const categoriesBtnId = `${brand.idPrefix}-categories-menu-btn`;
const categoriesDropdownId = `${brand.idPrefix}-categories-menu-dropdown`;

const MENU = SECTION_MENUS[brand.idPrefix];
// Most sections keep their tools under their own root, but DocWonder's hub is
// new while its tool pages predate it at /tools/ and carry search traffic, so
// the menu links where the pages actually are.
const TOOL_BASE = MENU.basePath || `${brand.rootPath}/`;
const NAME = Object.fromEntries((Astro.props.tools || []).map((t) => [t.slug, t.name]));

const toolsForSearch = getGlobalSearchIndex();
const { alternates = [] } = Astro.props;

---

<header class="sticky top-0 z-50 bg-[var(--bg-base)]/95 backdrop-blur border-b border-slate-800">

  <!-- Mobile: horizontal scrolling swipeable category pill bar (hidden on md+) -->
  <div class="md:hidden flex items-center gap-2 overflow-x-auto px-4 py-2.5 border-b border-slate-800/60 bg-[var(--bg-surface)] scrollbar-none">
    {SECTIONS.map(s => (
      <a href={s.path}
        class="flex items-center gap-1.5 shrink-0 px-3 py-1 rounded-full text-xs font-semibold text-white border transition-all"
        style={`background:rgba(${s.accentRgb},0.04);border-color:rgba(${s.accentRgb},0.15);`}>
        <span class="text-xs leading-none">{s.icon}</span>
        <span class="leading-none">{s.prefix}<span style={`color:${s.color}`}>{s.suffix}</span></span>
      </a>
    ))}
  </div>

  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 gap-3">
    <!-- Logo -->
    <a href={`${brand.rootPath}/`} class="flex items-center gap-2 group min-w-0 shrink md:shrink-0">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" style={`background:${brand.accentColor}`}>
        <slot name="icon">
          <span class="text-white font-bold text-xs">{brand.prefix[0]}</span>
        </slot>
      </div>
      <span class="hidden min-[375px]:inline text-xl sm:text-2xl md:text-xl lg:text-2xl font-bold text-white transition-colors whitespace-nowrap" style="font-family: 'Space Grotesk', sans-serif;">
        {brand.prefix}<span style={`color:${brand.accentColor}`}>{brand.suffix}</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      <!-- Points at the main site, not this section — the logo already covers
           the section index, so a second link to it would be dead weight. -->
      <a href="/" class="text-slate-300 hover:text-white transition-colors text-sm font-medium px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-surface-hover)] whitespace-nowrap shrink-0">Home</a>

      <ToolMegaMenu idPrefix={brand.idPrefix} label={`All ${brand.prefix} Tools`} accent={MENU.accent}
        basePath={TOOL_BASE} groups={MENU.groups} names={NAME} icons={TOOL_ICONS} />

      <!-- Divider: this section on the left, the wider site on the right. -->
      <span class="w-px h-5 bg-slate-800 mx-1"></span>

      <!-- Other sections of the site -->
      <div class="relative" id={categoriesWrapperId}>
        <button id={categoriesBtnId} data-mm-target={categoriesDropdownId} aria-haspopup="true" aria-expanded="false" class="flex items-center gap-1 text-slate-300 hover:text-white text-sm font-medium transition-colors px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-surface-hover)] whitespace-nowrap">
          More Tools
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <div id={categoriesDropdownId} class="hidden fixed left-1/2 -translate-x-1/2 w-[600px] max-w-[calc(100vw-2rem)] bg-[var(--bg-surface)] border border-slate-800 rounded-xl shadow-2xl overflow-hidden z-50">
          <div class="p-4 grid grid-cols-2 gap-3 bg-[var(--bg-surface)]">
            {SECTIONS.map(s => (
              <a href={s.path}
                class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-[var(--bg-surface-hover)] border border-transparent hover:border-slate-800 transition-all group">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 text-lg transition-transform group-hover:scale-105"
                  style={`background:rgba(${s.accentRgb},0.08); border: 1px solid rgba(${s.accentRgb},0.2)`}>
                  {s.icon}
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-bold text-white">{s.prefix}<span style={`color:${s.color}`}>{s.suffix}</span></span>
                    <span class="text-[10px] px-1.5 py-0.5 rounded-full font-medium"
                      style={`background:rgba(${s.accentRgb},0.1); color:${s.color};`}>
                      {s.count}
                    </span>
                  </div>
                  <p class="text-slate-500 text-xs mt-0.5 leading-snug truncate group-hover:text-slate-400">{s.tagline}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="bg-[var(--bg-surface-hover)] border-t border-slate-800/80 px-4 py-2.5 flex justify-between items-center text-xs">
            <span class="text-slate-500 font-normal">Fast, private, and 100% browser-based tools</span>
            <a href="/tools/" class="flex items-center gap-1 text-violet-400 hover:text-violet-300 font-medium transition-colors">
              View all tools ({toolsForSearch.length}) &rarr;
            </a>
          </div>
        </div>
      </div>
      <a href="/blog/" class="text-slate-300 hover:text-white transition-colors text-sm font-medium whitespace-nowrap px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-surface-hover)]">Blog</a>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2 shrink-0">
      <!-- Theme toggle -->
      <LanguageSwitcher alternates={alternates} locale="en" />

      <button id={toggleId} class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-[var(--bg-surface-hover)] transition-colors" aria-label="Toggle theme">
        <svg id={sunId} class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
        </svg>
        <svg id={moonId} class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Search -->
      <!-- Mobile tool browser. Search finds a tool if you know its name; this
           is for the more common case of not knowing it exists. -->
      <button id={`${brand.idPrefix}-mobile-tools-btn`} data-mm-target={`${brand.idPrefix}-mobile-tools-panel`}
        aria-haspopup="true" aria-expanded="false" aria-label="Browse tools"
        class="md:hidden flex items-center gap-1 shrink-0 bg-[var(--bg-surface-hover)] hover:bg-[var(--bg-surface-alt)] text-slate-300 hover:text-white px-2.5 py-2 rounded-lg transition-colors text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h6v6H4V6zm10 0h6v6h-6V6zM4 16h6v4H4v-4zm10 0h6v4h-6v-4z"/></svg>
        <span class="hidden min-[400px]:inline">Tools</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>

      <button id={searchOpenId} class="flex items-center gap-2 bg-[var(--bg-surface-hover)] hover:bg-[var(--bg-surface-alt)] text-slate-400 hover:text-white px-3 py-2 rounded-lg transition-colors text-sm" aria-label="Search tools">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <!-- lg, not sm: with the language switcher and the new Tools button in
             the cluster, showing this label at 820 pushed the row past the
             viewport on translated tools. -->
        <span class="hidden lg:inline">Search…</span>
      </button>
    </div>
  </div>
</header>

<!-- Search Modal -->
<ToolMobileSheet idPrefix={brand.idPrefix} accent={MENU.accent} basePath={TOOL_BASE}
  groups={MENU.groups} names={NAME} icons={TOOL_ICONS}
  browseLabel={`All ${brand.prefix} tools`} />

<MegaMenuScript />

<div id={searchModalId} class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id={searchBackdropId}></div>
  <div class="relative max-w-lg mx-auto mt-20 mx-4">
    <div class="bg-[var(--bg-surface)] border border-slate-700 rounded-2xl shadow-2xl overflow-hidden">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-slate-700">
        <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input id={searchInputId} type="text" placeholder="Search 150+ free tools…" class="flex-1 bg-transparent text-white placeholder-slate-500 outline-none text-base" autocomplete="off"/>
        <button id={searchCloseId} class="text-slate-400 hover:text-white transition-colors text-sm">ESC</button>
      </div>
      <ul id={searchResultsId} class="max-h-72 overflow-y-auto py-2"></ul>
    </div>
  </div>
</div>

<style>
  /* Custom scrollbar hiding helper */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script type="application/json" id="wonder-header-cfg" set:html={JSON.stringify({ toggleId, sunId, moonId, searchOpenId, searchModalId, searchInputId, searchResultsId, searchCloseId, searchBackdropId, categoriesWrapperId, categoriesBtnId, categoriesDropdownId })}></script>
<script>
import { searchTools, loadSearchIndex } from '../lib/search.js';
(function() {
  // Fetched on first use; see loadSearchIndex() in src/lib/search.js.
  let toolsForSearch = [];
  let searchIndexReady = false;
  function primeSearchIndex() {
    return loadSearchIndex().then((data) => { toolsForSearch = data; searchIndexReady = true; return data; });
  }
  const { toggleId, sunId, moonId, searchOpenId, searchModalId, searchInputId, searchResultsId, searchCloseId, searchBackdropId, categoriesWrapperId, categoriesBtnId, categoriesDropdownId } = JSON.parse(document.getElementById('wonder-header-cfg')?.textContent || '{}');
  // Theme
  const toggle = document.getElementById(toggleId);
  const sun = document.getElementById(sunId);
  const moon = document.getElementById(moonId);
  function applyTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    localStorage.setItem('tw-theme', t);
    if (t === 'dark') { sun.classList.remove('hidden'); moon.classList.add('hidden'); }
    else { sun.classList.add('hidden'); moon.classList.remove('hidden'); }
  }
  applyTheme(document.documentElement.getAttribute('data-theme') || 'dark');
  toggle.addEventListener('click', () => applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'));

  // Search
  const modal = document.getElementById(searchModalId);
  const input = document.getElementById(searchInputId);
  const results = document.getElementById(searchResultsId);
  const openBtn = document.getElementById(searchOpenId);
  const closeBtn = document.getElementById(searchCloseId);
  const backdrop = document.getElementById(searchBackdropId);

  function openModal() { modal.classList.remove('hidden'); setTimeout(() => input.focus(), 50); renderResults(''); }
  function closeModal() { modal.classList.add('hidden'); input.value = ''; }

  openBtn.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();   // menus close via MegaMenuScript
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openModal(); }
  });

  function renderResults(query) {

    if (!searchIndexReady) { primeSearchIndex().then(() => renderResults(query)); return; }
    const q = query.toLowerCase().trim();
    const filtered = q
      ? searchTools(toolsForSearch, q, 8)
      : toolsForSearch.slice(0, 8);
    results.innerHTML = filtered.length
      ? filtered.map(t => `<li><a href="${t.path}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-[var(--bg-surface-hover)] transition-colors"><div class="w-6 h-6 rounded flex items-center justify-center text-xs" style="background:${t.color}15;color:${t.color}">${t.icon || '⚙️'}</div><span class="text-white text-sm font-medium">${t.name}</span><span class="text-[10px] px-2 py-0.5 rounded-full font-medium ml-auto" style="background:${t.color}15;color:${t.color}">${t.category}</span></a></li>`).join('')
      : '<li class="px-4 py-4 text-slate-500 text-sm text-center">No tools found</li>';
  }
  input.addEventListener('input', e => renderResults(e.target.value));
})();
</script>
