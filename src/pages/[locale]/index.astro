---
// Localized home page (e.g. /es/). Mirrors the English homepage structure —
// hero, live search, stat row, category grid and the tabbed section dashboard —
// so switching language never drops the visitor onto a lesser page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import I18nHeader from '../../components/I18nHeader.astro';
import I18nFooter from '../../components/I18nFooter.astro';
import AdSlot from '../../components/AdSlot.astro';
import {
  allLocaleHomeRoutes, sectionsForLocale, sectionMeta, sectionPath,
  toolsForLocale, toolPath, alternatesForHome, toolCountForLocale,
  homePath, absolute, t, SECTION_BRANDS, LOCALES, localizedSearchIndex,
} from '../../i18n/index.js';

export function getStaticPaths() {
  return allLocaleHomeRoutes();
}

const { locale } = Astro.props;

const total = toolCountForLocale(locale);
const alternates = alternatesForHome();
const canonical = homePath(locale);

// Every section, with its full tool list — the catalogue is never truncated.
const sections = sectionsForLocale().map((key) => {
  const brand = SECTION_BRANDS[key];
  const meta = sectionMeta(locale, key);
  return {
    key,
    ...brand,
    name: meta.name,
    subtitle: meta.subtitle,
    count: meta.count,
    path: sectionPath(locale, key),
    tools: toolsForLocale(locale, key).map((tool) => ({
      name: tool.name,
      tagline: tool.tagline,
      path: toolPath(locale, key, tool.slug),
    })),
  };
});

// Flat index for the hero search box.
const searchIndex = sections.flatMap((s) =>
  s.tools.map((tool) => ({ name: tool.name, path: tool.path, category: s.name, color: s.color, icon: s.icon })),
);

// Suggestion pills: the first few translated tools, so they read natively.
const suggestions = sectionsForLocale()
  .flatMap((key) => toolsForLocale(locale, key).filter((tl) => tl.translated).map((tl) => tl.name))
  .slice(0, 4);

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TextWonder',
  url: absolute(canonical),
  inLanguage: LOCALES[locale].hreflang,
  description: t(locale, 'home.metaDescription', { count: total }),
};
---

<BaseLayout
  title={t(locale, 'home.metaTitle')}
  description={t(locale, 'home.metaDescription', { count: total })}
  canonical={canonical}
  lang={locale}
  alternates={alternates}
  searchIndex={localizedSearchIndex(locale)}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </Fragment>

  <I18nHeader locale={locale} alternates={alternates} />

  <main>
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="max-w-4xl mx-auto px-4 pt-16 pb-8 text-center relative">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.05] text-white mb-5">
        {t(locale, 'home.h1a')}<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600">{t(locale, 'home.h1b')}</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg max-w-xl mx-auto mb-8">{t(locale, 'home.sub', { count: sections.length })}</p>

      <div class="max-w-xl mx-auto relative mb-3">
        <div class="relative flex items-center bg-[var(--bg-surface)] border border-slate-800 rounded-2xl shadow-xl focus-within:border-violet-500 focus-within:ring-2 focus-within:ring-violet-500/20 transition-all overflow-hidden px-4 py-3.5">
          <svg class="w-5 h-5 text-slate-400 me-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" id="hero-search-input" placeholder={t(locale, 'home.searchPlaceholder', { count: total })}
            class="flex-1 bg-transparent text-white placeholder-slate-500 outline-none text-sm md:text-base" autocomplete="off" />
        </div>
        <div id="hero-search-dropdown" class="hidden absolute left-0 right-0 top-full mt-2 bg-[var(--bg-surface)] border border-slate-800 rounded-xl shadow-2xl overflow-hidden z-40 max-h-80 overflow-y-auto text-start">
          <ul id="hero-search-results" class="py-2"></ul>
        </div>
      </div>

      <div class="flex flex-wrap justify-center items-center gap-2 text-xs text-slate-500 mb-6">
        <span>{t(locale, 'home.try')}</span>
        {suggestions.map((name) => (
          <button class="popular-tag text-slate-400 hover:text-white transition-colors bg-[var(--bg-surface)] border border-slate-800/80 px-2.5 py-1 rounded-full cursor-pointer hover:border-slate-700" data-query={name}>{name}</button>
        ))}
      </div>

      <div class="inline-flex flex-wrap justify-center gap-x-5 gap-y-1.5 text-xs text-slate-500">
        <span><strong class="text-white font-semibold">{total}</strong> {t(locale, 'home.statTools')}</span>
        <span class="text-slate-700">·</span>
        <span><strong class="text-white font-semibold">{sections.length}</strong> {t(locale, 'home.statCategories')}</span>
        <span class="text-slate-700">·</span>
        <span><strong class="text-white font-semibold">100%</strong> {t(locale, 'home.statBrowser')}</span>
        <span class="text-slate-700">·</span>
        <span><strong class="text-white font-semibold">0</strong> {t(locale, 'home.statSignups')}</span>
      </div>
    </section>

    <!-- ── Category grid ────────────────────────────────────── -->
    <section class="max-w-5xl mx-auto px-4 pb-12">
      <h2 class="text-xs font-bold text-slate-500 uppercase tracking-widest text-center mb-6">{t(locale, 'home.browse')}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {sections.map((s, idx) => (
          <button
            class="category-card-btn group text-start flex flex-col justify-between p-4 bg-[var(--bg-surface)] border border-slate-800/80 rounded-2xl hover:border-slate-700 transition-all cursor-pointer relative overflow-hidden active:scale-[0.98]"
            data-index={idx}>
            <div class="flex items-center justify-between w-full mb-3">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center text-lg transition-transform group-hover:scale-105 shrink-0"
                style={`background:rgba(${s.accentRgb},0.15); border:1px solid rgba(${s.accentRgb},0.35)`}>
                {s.icon}
              </div>
              <span class="text-[10px] px-1.5 py-0.5 rounded-full font-bold shrink-0"
                style={`background:rgba(${s.accentRgb},0.1); color:${s.color};`}>{s.count}</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white transition-colors" style="font-family:'Space Grotesk',sans-serif;">{s.name}</h3>
              <p class="text-slate-500 text-[10px] leading-snug mt-1 line-clamp-2 group-hover:text-slate-400 transition-colors">{s.subtitle}</p>
            </div>
          </button>
        ))}
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 pb-8">
      <AdSlot slot="3456789012" format="horizontal" />
    </section>

    <!-- ── Section dashboard ────────────────────────────────── -->
    <section class="max-w-5xl mx-auto px-4 pb-16" id="dashboard-section">
      <div class="border-b border-slate-800/80 mb-6 flex items-center gap-1 overflow-x-auto pb-px scrollbar-none">
        {sections.map((s, idx) => (
          <button
            class="dashboard-tab-btn flex items-center gap-1.5 px-4 py-3.5 border-b-2 border-transparent text-sm font-bold text-slate-400 hover:text-white hover:border-slate-800 transition-all shrink-0 cursor-pointer"
            data-index={idx} data-color={s.color} data-accent-rgb={s.accentRgb}>
            <span class="text-base">{s.icon}</span>
            <span>{s.name}</span>
          </button>
        ))}
      </div>

      <div class="bg-[var(--bg-surface)] border border-slate-800/80 rounded-3xl p-6 sm:p-8 relative overflow-hidden">
        {sections.map((s, idx) => (
          <div class="tab-pane hidden" data-index={idx}>
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800/80 pb-6 mb-6">
              <div class="min-w-0">
                <div class="flex items-center gap-2.5 flex-wrap">
                  <h3 class="text-2xl font-bold text-white" style="font-family:'Space Grotesk',sans-serif;">{s.name}</h3>
                  <span class="text-xs px-2.5 py-0.5 rounded-full font-medium"
                    style={`background:rgba(${s.accentRgb},0.1);color:${s.color};border:1px solid rgba(${s.accentRgb},0.2)`}>
                    {t(locale, 'home.toolsAvailable', { count: s.count })}
                  </span>
                </div>
                <p class="text-slate-400 text-sm mt-1.5 leading-relaxed">{s.subtitle}</p>
              </div>
              <a href={s.path}
                class="shrink-0 flex items-center justify-center gap-1.5 text-sm font-bold px-5 py-2.5 rounded-xl transition-all hover:brightness-110 active:scale-[0.98]"
                style={`color:#fff;background:${s.color};box-shadow:0 4px 12px rgba(${s.accentRgb},0.2)`}>
                {t(locale, 'home.viewSection', { name: s.name })}
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {s.tools.map((tool, tIdx) => (
                <a href={tool.path}
                  class={`block bg-[var(--bg-base)] border border-slate-800/80 rounded-2xl p-5 hover:border-slate-700 transition-all hover:-translate-y-0.5 hover:shadow-lg ${tIdx >= 6 ? 'hidden extra-tool' : ''}`}>
                  <div class="flex items-start justify-between mb-2 gap-2">
                    <h4 class="text-white font-bold text-base">{tool.name}</h4>
                    <div class="w-6 h-6 rounded-md flex items-center justify-center text-xs shrink-0"
                      style={`background:rgba(${s.accentRgb},0.15); color:${s.color}; border:1px solid rgba(${s.accentRgb},0.28)`}>
                      {s.icon}
                    </div>
                  </div>
                  <p class="text-slate-500 text-xs leading-snug line-clamp-2 mt-1">{tool.tagline || t(locale, 'home.cardDesc')}</p>
                  <div class="flex items-center text-[10px] font-bold mt-4 uppercase tracking-wider" style={`color:${s.color};`}>
                    {t(locale, 'home.launch')} &rarr;
                  </div>
                </a>
              ))}
            </div>

            {s.count > 6 && (
              <div class="flex justify-center mt-8 pt-2">
                <button
                  class="expand-tools-btn flex items-center gap-1.5 text-xs font-bold px-6 py-3 rounded-full border transition-all cursor-pointer active:scale-95 hover:brightness-110"
                  style={`color:${s.color};background:rgba(${s.accentRgb},0.05);border-color:rgba(${s.accentRgb},0.2);`}
                  data-expanded="false" data-index={idx}
                  data-more={t(locale, 'home.showAll', { count: s.count })}
                  data-less={t(locale, 'home.showLess')}>
                  <span class="btn-text">{t(locale, 'home.showAll', { count: s.count })}</span>
                  <svg class="w-3.5 h-3.5 transition-transform arrow-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </button>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 pb-8">
      <AdSlot slot="4567890123" format="horizontal" />
    </section>

    <!-- ── Privacy ──────────────────────────────────────────── -->
    <section class="bg-[var(--bg-surface)] border-y border-slate-800 py-12">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <div class="text-3xl mb-3">🔒</div>
        <h2 class="text-xl font-bold text-white mb-2" style="font-family:'Space Grotesk',sans-serif;">{t(locale, 'home.privacyTitle')}</h2>
        <p class="text-slate-400 text-sm max-w-xl mx-auto mb-6 leading-relaxed">{t(locale, 'home.privacyBody')}</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-xl mx-auto">
          <div class="bg-[var(--bg-base)] rounded-xl p-3.5 border border-slate-800">
            <div class="text-emerald-400 font-bold text-sm mb-0.5">{t(locale, 'home.noServers')}</div>
            <div class="text-slate-500 text-xs">{t(locale, 'home.noServersDesc')}</div>
          </div>
          <div class="bg-[var(--bg-base)] rounded-xl p-3.5 border border-slate-800">
            <div class="text-emerald-400 font-bold text-sm mb-0.5">{t(locale, 'home.noAccounts')}</div>
            <div class="text-slate-500 text-xs">{t(locale, 'home.noAccountsDesc')}</div>
          </div>
          <div class="bg-[var(--bg-base)] rounded-xl p-3.5 border border-slate-800">
            <div class="text-emerald-400 font-bold text-sm mb-0.5">{t(locale, 'home.noTracking')}</div>
            <div class="text-slate-500 text-xs">{t(locale, 'home.noTrackingDesc')}</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <I18nFooter locale={locale} />
</BaseLayout>

<script type="application/json" id="locale-home-cfg" set:html={JSON.stringify({ noneText: t(locale, 'search.none') })}></script>
<script>
import { searchTools } from '../../lib/search.js';
const searchIndex = JSON.parse(document.getElementById('tw-search-data')?.textContent || '[]');
const { noneText } = JSON.parse(document.getElementById('locale-home-cfg')?.textContent || '{}');
(function () {
  const esc = (v) => String(v).replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // ── Hero search ──────────────────────────────────────────
  const input = document.getElementById('hero-search-input');
  const dropdown = document.getElementById('hero-search-dropdown');
  const results = document.getElementById('hero-search-results');

  function render(query) {
    const q = query.toLowerCase().trim();
    if (!q) { dropdown.classList.add('hidden'); return; }
    const hits = searchTools(searchIndex, q, 12);
    results.innerHTML = hits.length
      ? hits.map((t) => `<li><a href="${esc(t.path)}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-[var(--bg-surface-hover)] transition-colors"><span class="w-6 h-6 rounded flex items-center justify-center text-xs shrink-0" style="background:${esc(t.color)}15;color:${esc(t.color)}">${esc(t.icon)}</span><span class="text-white text-sm font-medium">${esc(t.name)}</span><span class="text-[10px] px-2 py-0.5 rounded-full font-medium ms-auto" style="background:${esc(t.color)}15;color:${esc(t.color)}">${esc(t.category)}</span></a></li>`).join('')
      : `<li class="px-4 py-4 text-slate-500 text-sm text-center">${esc(noneText)}</li>`;
    dropdown.classList.remove('hidden');
  }

  input && input.addEventListener('input', (e) => render(e.target.value));
  document.addEventListener('click', (e) => {
    if (input && !input.contains(e.target) && dropdown && !dropdown.contains(e.target)) dropdown.classList.add('hidden');
  });

  document.querySelectorAll('.popular-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      input.value = btn.dataset.query;
      input.focus();
      render(btn.dataset.query);
    });
  });

  // ── Section dashboard tabs ───────────────────────────────
  const tabs = Array.from(document.querySelectorAll('.dashboard-tab-btn'));
  const panes = Array.from(document.querySelectorAll('.tab-pane'));

  function activate(idx) {
    tabs.forEach((tab) => {
      const on = tab.dataset.index === String(idx);
      tab.style.color = on ? tab.dataset.color : '';
      tab.style.borderBottomColor = on ? tab.dataset.color : 'transparent';
    });
    panes.forEach((pane) => pane.classList.toggle('hidden', pane.dataset.index !== String(idx)));
  }

  tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.dataset.index)));
  document.querySelectorAll('.category-card-btn').forEach((card) => {
    card.addEventListener('click', () => {
      activate(card.dataset.index);
      document.getElementById('dashboard-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
  if (tabs.length) activate(0);

  // ── Show all / show less ─────────────────────────────────
  document.querySelectorAll('.expand-tools-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const pane = btn.closest('.tab-pane');
      const expanded = btn.dataset.expanded === 'true';
      pane.querySelectorAll('.extra-tool').forEach((el) => el.classList.toggle('hidden', expanded));
      btn.dataset.expanded = String(!expanded);
      btn.querySelector('.btn-text').textContent = expanded ? btn.dataset.more : btn.dataset.less;
      btn.querySelector('.arrow-icon').style.transform = expanded ? '' : 'rotate(180deg)';
    });
  });
})();
</script>
