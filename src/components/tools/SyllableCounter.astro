---
---

<div class="space-y-6">
  <!-- Input Section -->
  <div>
    <label class="text-slate-100 text-sm font-semibold mb-3 block flex items-center gap-2">
      <span class="text-lg">✍️</span> Input Text
    </label>
    <textarea id="sc-input" rows="6" placeholder="Paste text or type here — syllables will be counted per word..." class="w-full bg-gradient-to-br from-slate-800 to-slate-900 border-2 border-violet-500/30 rounded-2xl px-5 py-4 text-slate-50 placeholder-slate-500 resize-y outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-400 text-sm font-medium transition-all hover:border-violet-400/50"></textarea>
  </div>

  <!-- Metrics Grid - Enhanced -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <!-- Total Syllables -->
    <div class="group relative">
      <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-purple-600 rounded-2xl blur-lg opacity-0 group-hover:opacity-100 transition duration-500"></div>
      <div class="relative bg-gradient-to-br from-violet-600/20 to-violet-600/5 border-2 border-violet-500/50 backdrop-blur-lg rounded-2xl px-5 py-4 text-center hover:border-violet-400 transition-all">
        <div class="text-3xl font-bold bg-gradient-to-r from-violet-300 to-violet-200 bg-clip-text text-transparent" id="sc-total">0</div>
        <div class="text-xs text-violet-200/70 mt-2 font-medium">Total Syllables</div>
      </div>
    </div>

    <!-- Words -->
    <div class="group relative">
      <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-cyan-600 rounded-2xl blur-lg opacity-0 group-hover:opacity-100 transition duration-500"></div>
      <div class="relative bg-gradient-to-br from-blue-600/20 to-blue-600/5 border-2 border-blue-500/50 backdrop-blur-lg rounded-2xl px-5 py-4 text-center hover:border-blue-400 transition-all">
        <div class="text-3xl font-bold bg-gradient-to-r from-blue-300 to-blue-200 bg-clip-text text-transparent" id="sc-words">0</div>
        <div class="text-xs text-blue-200/70 mt-2 font-medium">Words</div>
      </div>
    </div>

    <!-- Avg per Word -->
    <div class="group relative">
      <div class="absolute inset-0 bg-gradient-to-r from-emerald-600 to-teal-600 rounded-2xl blur-lg opacity-0 group-hover:opacity-100 transition duration-500"></div>
      <div class="relative bg-gradient-to-br from-emerald-600/20 to-emerald-600/5 border-2 border-emerald-500/50 backdrop-blur-lg rounded-2xl px-5 py-4 text-center hover:border-emerald-400 transition-all">
        <div class="text-3xl font-bold bg-gradient-to-r from-emerald-300 to-emerald-200 bg-clip-text text-transparent" id="sc-avg">0.0</div>
        <div class="text-xs text-emerald-200/70 mt-2 font-medium">Avg / Word</div>
      </div>
    </div>

    <!-- Polysyllabic -->
    <div class="group relative">
      <div class="absolute inset-0 bg-gradient-to-r from-orange-600 to-red-600 rounded-2xl blur-lg opacity-0 group-hover:opacity-100 transition duration-500"></div>
      <div class="relative bg-gradient-to-br from-orange-600/20 to-orange-600/5 border-2 border-orange-500/50 backdrop-blur-lg rounded-2xl px-5 py-4 text-center hover:border-orange-400 transition-all">
        <div class="text-3xl font-bold bg-gradient-to-r from-orange-300 to-orange-200 bg-clip-text text-transparent" id="sc-poly">0</div>
        <div class="text-xs text-orange-200/70 mt-2 font-medium">Polysyllabic (3+)</div>
      </div>
    </div>
  </div>

  <!-- Poetry Validators - Enhanced -->
  <div class="bg-gradient-to-br from-indigo-950/40 to-purple-950/40 border-2 border-indigo-500/40 backdrop-blur-sm rounded-2xl p-6">
    <h3 class="text-slate-100 font-bold text-base mb-4 flex items-center gap-2">
      <span class="text-lg">🎭</span> Poetry Format Detector
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Haiku -->
      <div class="bg-gradient-to-br from-pink-600/15 to-rose-600/15 border-2 border-pink-500/40 rounded-xl p-4 text-center hover:border-pink-400/70 transition-all">
        <div class="text-xs font-semibold text-pink-200 mb-2">🌸 Haiku</div>
        <div class="text-xs text-pink-100/60 mb-2">(5-7-5)</div>
        <div id="sc-haiku" class="text-sm font-bold text-pink-300">–</div>
      </div>

      <!-- Limerick -->
      <div class="bg-gradient-to-br from-yellow-600/15 to-amber-600/15 border-2 border-yellow-500/40 rounded-xl p-4 text-center hover:border-yellow-400/70 transition-all">
        <div class="text-xs font-semibold text-yellow-200 mb-2">😄 Limerick</div>
        <div class="text-xs text-yellow-100/60 mb-2">(8-8-5-5-8)</div>
        <div id="sc-limerick" class="text-sm font-bold text-yellow-300">–</div>
      </div>

      <!-- Sonnet -->
      <div class="bg-gradient-to-br from-cyan-600/15 to-blue-600/15 border-2 border-cyan-500/40 rounded-xl p-4 text-center hover:border-cyan-400/70 transition-all">
        <div class="text-xs font-semibold text-cyan-200 mb-2">✨ Sonnet</div>
        <div class="text-xs text-cyan-100/60 mb-2">(10 per line)</div>
        <div id="sc-sonnet" class="text-sm font-bold text-cyan-300">–</div>
      </div>
    </div>
  </div>

  <!-- Action Buttons - Enhanced -->
  <div class="flex flex-wrap gap-3">
    <button id="sc-copy" class="px-5 py-2.5 bg-gradient-to-r from-violet-600 to-violet-700 hover:from-violet-500 hover:to-violet-600 text-white rounded-xl text-sm font-semibold shadow-lg shadow-violet-500/30 hover:shadow-violet-500/50 transition-all duration-300 active:scale-95">📋 Copy Results</button>
    <button id="sc-export-csv" class="px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white rounded-xl text-sm font-semibold shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 transition-all duration-300 active:scale-95">⬇️ CSV</button>
    <button id="sc-export-json" class="px-5 py-2.5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white rounded-xl text-sm font-semibold shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 transition-all duration-300 active:scale-95">⬇️ JSON</button>
    <button id="sc-clear" class="px-5 py-2.5 bg-gradient-to-r from-slate-700 to-slate-800 hover:from-slate-600 hover:to-slate-700 text-slate-100 rounded-xl text-sm font-semibold shadow-lg shadow-slate-900/30 hover:shadow-slate-900/50 transition-all duration-300 active:scale-95">🗑️ Clear</button>
  </div>

  <!-- Word Breakdown - Enhanced -->
  <div id="sc-breakdown" class="space-y-3">
    <p class="text-xs text-slate-400 font-medium">✨ Enter text to see word-by-word syllable breakdown</p>
  </div>

  <!-- How It Works - Enhanced -->
  <div class="bg-gradient-to-br from-indigo-950/50 to-slate-900/50 border-2 border-indigo-500/30 backdrop-blur-sm rounded-2xl p-6">
    <h3 class="text-slate-100 font-bold text-sm mb-4 flex items-center gap-2">
      <span class="text-lg">📚</span> How Syllable Counting Works
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="bg-blue-600/10 border border-blue-500/30 rounded-lg p-3">
        <p class="text-xs font-semibold text-blue-200 mb-1">📊 Vowel Groups</p>
        <p class="text-xs text-blue-100/70">Each vowel cluster = 1 syllable</p>
      </div>
      <div class="bg-purple-600/10 border border-purple-500/30 rounded-lg p-3">
        <p class="text-xs font-semibold text-purple-200 mb-1">🔤 Silent E</p>
        <p class="text-xs text-purple-100/70">Words ending in 'e' usually don't add</p>
      </div>
      <div class="bg-pink-600/10 border border-pink-500/30 rounded-lg p-3">
        <p class="text-xs font-semibold text-pink-200 mb-1">Y as Vowel</p>
        <p class="text-xs text-pink-100/70">'y' between consonants acts as vowel</p>
      </div>
      <div class="bg-teal-600/10 border border-teal-500/30 rounded-lg p-3">
        <p class="text-xs font-semibold text-teal-200 mb-1">⚡ Short Words</p>
        <p class="text-xs text-teal-100/70">3 letters or less = 1 syllable</p>
      </div>
    </div>
  </div>
</div>

<script>
function countSyllables(word) {
  word = word.toLowerCase().replace(/[^a-z]/g, '');
  if (!word) return 0;
  if (word.length <= 3) return 1;
  word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '');
  word = word.replace(/^y/, '');
  const m = word.match(/[aeiouy]{1,2}/g);
  return m ? m.length : 1;
}

function getSyllableColor(s) {
  if (s === 1) return 'bg-gradient-to-br from-blue-600/25 to-blue-600/5 border-blue-500/50 text-blue-100 shadow-lg shadow-blue-500/10';
  if (s === 2) return 'bg-gradient-to-br from-purple-600/25 to-purple-600/5 border-purple-500/50 text-purple-100 shadow-lg shadow-purple-500/10';
  if (s >= 3) return 'bg-gradient-to-br from-orange-600/25 to-orange-600/5 border-orange-500/50 text-orange-100 shadow-lg shadow-orange-500/10';
  return 'bg-gradient-to-br from-slate-600/25 to-slate-600/5 border-slate-500/50 text-slate-100 shadow-lg shadow-slate-500/10';
}

let currentBreakdown = [];

function count() {
  const text = document.getElementById('sc-input').value;
  const lines = text.split('\n').filter(l => l.trim());
  const words = text.match(/[a-zA-Z']+/g) || [];
  let total = 0, poly = 0;

  currentBreakdown = words.map(w => {
    const s = countSyllables(w);
    total += s;
    if (s >= 3) poly++;
    return { w, s };
  });

  document.getElementById('sc-total').textContent = total;
  document.getElementById('sc-words').textContent = words.length;
  document.getElementById('sc-avg').textContent = words.length ? (total / words.length).toFixed(1) : '0.0';
  document.getElementById('sc-poly').textContent = poly;

  // Poetry validators
  const lineSyllables = lines.map(line => (line.match(/[a-zA-Z']+/g) || []).reduce((sum, w) => sum + countSyllables(w), 0));
  const isHaiku = lineSyllables.length === 3 && lineSyllables[0] === 5 && lineSyllables[1] === 7 && lineSyllables[2] === 5;
  const isLimerick = lineSyllables.length === 5 && lineSyllables[0] === 8 && lineSyllables[1] === 8 && lineSyllables[2] === 5 && lineSyllables[3] === 5 && lineSyllables[4] === 8;
  const isSonnet = lineSyllables.length === 14 && lineSyllables.every(s => s === 10);

  document.getElementById('sc-haiku').textContent = isHaiku ? '✅ Valid!' : '❌ Not a haiku';
  document.getElementById('sc-limerick').textContent = isLimerick ? '✅ Valid!' : '❌ Not a limerick';
  document.getElementById('sc-sonnet').textContent = isSonnet ? '✅ Valid!' : '❌ Not a sonnet';

  // Breakdown display
  const bd = document.getElementById('sc-breakdown');
  if (currentBreakdown.length === 0) {
    bd.innerHTML = '<p class="text-xs text-slate-500">Enter text to see word-by-word breakdown</p>';
    return;
  }

  bd.innerHTML = '<p class="text-xs text-slate-400 font-semibold mb-3">Word-by-word syllable count:</p>' +
    '<div class="flex flex-wrap gap-2.5">' +
    currentBreakdown.map(({w,s}) => {
      const color = getSyllableColor(s);
      const labelColor = s === 1 ? 'text-blue-300' : s === 2 ? 'text-purple-300' : s >= 3 ? 'text-orange-300' : 'text-slate-300';
      return `<div class="border-2 ${color} rounded-xl px-3.5 py-2 text-sm font-medium backdrop-blur-sm hover:shadow-xl transition-all duration-300">
        <span class="font-semibold">${w}</span>
        <span class="${labelColor} font-bold ml-2">${s}</span>
      </div>`;
    }).join('') + '</div>';
}

// Event listeners
document.getElementById('sc-input').addEventListener('input', count);

document.getElementById('sc-copy').addEventListener('click', () => {
  if (currentBreakdown.length === 0) return;
  const text = currentBreakdown.map(({w,s}) => `${w}: ${s}`).join('\n');
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('sc-copy');
    const orig = btn.textContent;
    btn.textContent = '✅ Copied!';
    setTimeout(() => btn.textContent = orig, 2000);
  });
});

document.getElementById('sc-export-csv').addEventListener('click', () => {
  if (currentBreakdown.length === 0) return;
  const csv = 'Word,Syllables\n' + currentBreakdown.map(({w,s}) => `${w},${s}`).join('\n');
  const blob = new Blob([csv], {type: 'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'syllables.csv';
  a.click();
});

document.getElementById('sc-export-json').addEventListener('click', () => {
  if (currentBreakdown.length === 0) return;
  const json = JSON.stringify({
    total_syllables: currentBreakdown.reduce((sum, {s}) => sum + s, 0),
    total_words: currentBreakdown.length,
    words: currentBreakdown
  }, null, 2);
  const blob = new Blob([json], {type: 'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'syllables.json';
  a.click();
});

document.getElementById('sc-clear').addEventListener('click', () => {
  document.getElementById('sc-input').value = '';
  count();
});
</script>
