---
// DocWonder hub. Previously this section had no landing page of its own —
// it was reachable only at /categories/document-generators/, a generic
// category listing, while every sibling section had a branded index.
//
// The tool pages themselves stay at /tools/<slug>/. They predate this hub and
// carry the site's second-highest click share (11 of 84 clicks over 68 days,
// with noc-generator at position 21.7 and relieving-letter at 24.8), so moving
// them is a separate decision with a real cost, not a tidy-up.
import BaseLayout from '../../layouts/BaseLayout.astro';
import WonderHeader from '../../components/WonderHeader.astro';
import Footer from '../../components/Footer.astro';
import ToolSearchBar from '../../components/ToolSearchBar.astro';
import { TOOLS } from '../../data/tools.js';
import { PDF_TOOLS } from '../../data/pdftools.js';
// Text-tool records carry no `icon`/`iconBg` — unlike PDF and Image tools —
// so the cards use the same inline SVGs as the menu rather than rendering an
// empty coloured square.
import { TOOL_ICONS } from '../../data/tool-icons.js';

const DOC_TOOLS = TOOLS.filter((t) => t.category === 'document-generators');
const brand = {
  name: 'DocWonder', prefix: 'Doc', suffix: 'Wonder',
  rootPath: '/docwonder', accentColor: '#0d9488', idPrefix: 'doc',
};
---

<BaseLayout
  title="Free Document Generators — Rent Receipt, Salary Slip & Letters | DocWonder"
  description="Generate rent receipts, salary slips, experience and relieving letters, NOCs and proforma invoices. Free, formatted for Indian use, and built entirely in your browser."
  canonical="/docwonder/"
>
  <WonderHeader brand={brand} tools={DOC_TOOLS} />

  <main>
    <!-- Hero -->
    <section class="max-w-4xl mx-auto px-4 pt-12 pb-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-teal-950/50 border border-teal-800/40 text-teal-400 text-xs font-medium mb-5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        100% browser-based — nothing you type is uploaded
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white leading-tight mb-3" style="font-family: 'Space Grotesk', sans-serif;">
        Documents you need,<br class="hidden sm:block" /> formatted properly
      </h1>
      <p class="text-slate-400 text-lg max-w-xl mx-auto mb-5">
        Rent receipts for HRA, salary slips, experience and relieving letters, NOCs and proforma invoices — filled in, formatted, and ready to print or save as PDF.
      </p>
      <div class="inline-flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm text-slate-500">
        <span><strong class="text-teal-400 font-semibold">{DOC_TOOLS.length}</strong> document generators</span>
        <span class="hidden sm:inline text-slate-700">·</span>
        <span><strong class="text-teal-400 font-semibold">100%</strong> browser-based</span>
        <span class="hidden sm:inline text-slate-700">·</span>
        <span><strong class="text-teal-400 font-semibold">0</strong> signups required</span>
      </div>
    </section>

    <!-- Tools -->
    <section class="max-w-6xl mx-auto px-4 pb-16">
      <ToolSearchBar accentColor="#0d9488" placeholder="Search document generators…" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {DOC_TOOLS.map((tool) => (
          <a
            href={`/tools/${tool.slug}/`}
            data-tool-card
            data-name={tool.name}
            data-tagline={tool.tagline}
            class="group block bg-[var(--bg-surface)] border border-slate-800 rounded-2xl p-5 hover:border-teal-500/50 hover:bg-[var(--bg-surface-hover)] transition-all"
          >
            <div class="flex items-start gap-4 mb-3">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 bg-teal-500/10 border border-teal-500/25">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#0d9488"
                  stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  set:html={TOOL_ICONS[tool.slug]} />
              </div>
              <div class="flex-1 min-w-0">
                <h2 class="text-white font-semibold text-base group-hover:text-teal-400 transition-colors">{tool.name}</h2>
                <p class="text-slate-400 text-sm leading-snug mt-0.5">{tool.tagline}</p>
              </div>
            </div>
            <div class="flex items-center text-xs text-teal-400/60 group-hover:text-teal-400 transition-colors font-medium">
              Open tool
              <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- What these are for -->
    <section class="max-w-4xl mx-auto px-4 pb-16 grid gap-6 md:grid-cols-2">
      <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-2" style="font-family:'Space Grotesk',sans-serif;">Built around Indian paperwork</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Rent receipts carry the landlord PAN field that HRA claims over ₹1,00,000 a year
          require, and leave space for a revenue stamp. Salary slips separate earnings from
          deductions the way a payroll department expects. Proforma invoices include GST.
          These are the details that turn a generic template into something an employer or
          assessing officer will accept.
        </p>
      </div>
      <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-2" style="font-family:'Space Grotesk',sans-serif;">Nothing you type is uploaded</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Every generator runs as JavaScript in your browser and prints straight from the
          page. Salary figures, landlord names, PANs and employee details never reach a
          server, because there is no server to reach — which matters more here than in most
          tools, given what goes into these forms.
        </p>
      </div>
    </section>

    <!-- Honest limits -->
    <section class="max-w-4xl mx-auto px-4 pb-16">
      <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-2xl p-8">
        <h2 class="text-xl font-bold text-white mb-2" style="font-family:'Space Grotesk',sans-serif;">Formatting is not legality</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          These generators format whatever you enter — they do not verify it. A correctly
          laid-out document stating something untrue is still untrue, and misrepresenting
          rent, salary or employment to a landlord, employer or tax authority can be an
          offence. Have anything with legal or tax consequence checked by a qualified
          professional. Our <a href="/disclaimer/" class="text-teal-400 hover:text-teal-300 underline">disclaimer</a> covers this in full.
        </p>
      </div>
    </section>

    <!-- Cross-promo -->
    <section class="max-w-4xl mx-auto px-4 pb-16 grid sm:grid-cols-2 gap-4">
      <div class="flex items-center justify-between bg-[var(--bg-surface)] border border-violet-800/30 rounded-2xl p-5">
        <div>
          <p class="text-sm text-slate-400">Need text tools?</p>
          <p class="text-white font-semibold" style="font-family:'Space Grotesk',sans-serif;">Text<span class="text-violet-400">Wonder</span> — {TOOLS.length} utilities</p>
        </div>
        <a href="/" class="shrink-0 px-4 py-2 bg-violet-600 hover:bg-violet-500 text-white rounded-lg text-sm font-medium transition-colors">Visit →</a>
      </div>
      <div class="flex items-center justify-between bg-[var(--bg-surface)] border border-orange-800/30 rounded-2xl p-5">
        <div>
          <p class="text-sm text-slate-400">Need PDF tools?</p>
          <p class="text-white font-semibold" style="font-family:'Space Grotesk',sans-serif;">PDF<span class="text-orange-400">Wonder</span> — {PDF_TOOLS.length} utilities</p>
        </div>
        <a href="/pdfwonder/" class="shrink-0 px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white rounded-lg text-sm font-medium transition-colors">Visit →</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
