---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SECTIONS, getGlobalSearchIndex } from '../data/categories.js';
import { PDF_TOOLS } from '../data/pdftools.js';
import { PDF_ICONS, PDF_ICON_GROUPS } from '../data/pdf-icons.js';

const toolsForSearch = getGlobalSearchIndex();
const { alternates = [] } = Astro.props;

// Grouped by the job someone came to do, not by anything in the data - the
// tool records carry no category. Previously the header offered no route to a
// second PDF tool at all: "Categories" lists the site's other sections, so
// finishing a merge and wanting to compress meant going back to the index.
const NAME = Object.fromEntries(PDF_TOOLS.map((t) => [t.slug, t.name]));
const GROUPS: Array<{ title: string; slugs: string[] }> = [
  { title: 'Organise', slugs: ['pdf-merger', 'pdf-splitter', 'pdf-extract-pages', 'pdf-remove-pages', 'pdf-reorder-pages', 'pdf-rotate-pages', 'pdf-remove-blank-pages'] },
  { title: 'Convert',  slugs: ['jpg-to-pdf', 'pdf-to-jpg', 'pdf-to-png', 'pdf-to-text', 'text-to-pdf', 'text-to-word', 'markdown-to-pdf'] },
  { title: 'Optimise', slugs: ['pdf-compress', 'pdf-resize', 'pdf-crop', 'pdf-grayscale', 'pdf-scan-enhance', 'pdf-dark-mode'] },
  { title: 'Edit',     slugs: ['pdf-watermark', 'pdf-page-numbers', 'pdf-header-footer', 'pdf-sign'] },
  { title: 'Secure & inspect', slugs: ['pdf-password-protect', 'pdf-unlock', 'pdf-metadata-viewer', 'pdf-word-count'] },
];
---

<header class="sticky top-0 z-50 bg-[var(--bg-base)]/95 backdrop-blur border-b border-slate-800">

  <!-- Mobile: horizontal scrolling swipeable category pill bar (hidden on md+) -->
  <div class="md:hidden flex items-center gap-2 overflow-x-auto px-4 py-2.5 border-b border-slate-800/60 bg-[var(--bg-surface)] scrollbar-none">
    {SECTIONS.map(s => (
      <a href={s.path}
        class="flex items-center gap-1.5 shrink-0 px-3 py-1 rounded-full text-xs font-semibold text-white border transition-all"
        style={`background:rgba(${s.accentRgb},0.04);border-color:rgba(${s.accentRgb},0.15);`}>
        <span class="text-xs leading-none">{s.icon}</span>
        <span class="leading-none">{s.prefix}<span style={`color:${s.color}`}>{s.suffix}</span></span>
      </a>
    ))}
  </div>

  <!-- Matches the content container in PDFToolLayout; at max-w-6xl the header
       sat visibly inset from the tool card once the pages went full width. -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 gap-3">
    <!-- Logo -->
    <a href="/pdfwonder/" class="flex items-center gap-2 group min-w-0 shrink md:shrink-0">
      <div class="w-8 h-8 rounded-lg bg-orange-500 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM8 17h8v1H8v-1zm0-3h8v1H8v-1zm0-3h5v1H8v-1z"/>
        </svg>
      </div>
      <!-- Hidden below 400px rather than truncated. On translated tools the
           right-hand cluster also carries a language switcher, and the
           wordmark could not fit beside it - but "PDFWond…" reads as broken,
           whereas the icon alone reads as deliberate, and the pill row
           directly above still names the section. -->
      <span class="hidden min-[375px]:inline text-xl sm:text-2xl md:text-xl lg:text-2xl font-bold text-white group-hover:text-orange-400 transition-colors whitespace-nowrap" style="font-family: 'Space Grotesk', sans-serif;">
        PDF<span class="text-orange-500">Wonder</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      <!-- Points at the main site, not /pdfwonder/ — the logo already covers
           the section index, so a second link to it would be dead weight. -->
      <a href="/" class="text-slate-300 hover:text-white transition-colors text-sm font-medium px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-surface-hover)] whitespace-nowrap shrink-0">Home</a>

      <!-- All PDF tools: the route between tools that the header was missing -->
      <div class="relative" id="pdf-tools-menu-wrapper">
        <button id="pdf-tools-menu-btn" aria-haspopup="true" aria-expanded="false"
          class="flex items-center gap-1 text-slate-300 hover:text-white text-sm font-medium transition-colors px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-surface-hover)] whitespace-nowrap">
          All PDF Tools
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <!-- Width is clamped to the viewport, and JS nudges `left` on open so
             the panel cannot hang off the right edge. Anchoring it to the
             button alone pushed the page into horizontal overflow between 768
             and 1024, where the button sits far enough in that a fixed-width
             panel no longer fits. -->
        <div id="pdf-tools-menu-dropdown" class="hidden absolute left-0 top-full mt-2 w-[940px] max-w-[calc(100vw-2rem)] bg-[var(--bg-surface)] border border-slate-800 rounded-xl shadow-2xl overflow-hidden z-50">
          <div class="p-4 grid grid-cols-3 lg:grid-cols-5 gap-x-4 gap-y-1">
            {GROUPS.map((g) => (
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-wide px-2 pb-1.5 pt-1" style={`color:${PDF_ICON_GROUPS[g.title]}`}>{g.title}</p>
                <ul>
                  {g.slugs.map((slug) => (
                    <li>
                      <a href={`/pdfwonder/${slug}/`}
                        class="flex items-center gap-2 px-2 py-1.5 rounded-md text-[13px] text-slate-300 hover:text-white hover:bg-[var(--bg-surface-hover)] transition-colors">
                        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke={PDF_ICON_GROUPS[g.title]}
                          stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                          set:html={PDF_ICONS[slug]} />
                        <span>{NAME[slug]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="bg-[var(--bg-surface-hover)] border-t border-slate-800/80 px-4 py-2.5 flex justify-between items-center text-xs">
            <span class="text-slate-500">All {PDF_TOOLS.length} run in your browser — nothing is uploaded</span>
            <a href="/pdfwonder/" class="text-orange-400 hover:text-orange-300 font-medium transition-colors">Browse all {PDF_TOOLS.length} &rarr;</a>
          </div>
        </div>
      </div>

      <!-- Divider: everything left of it is PDF, everything right is the wider
           site. Individual tool shortcuts used to sit here and were removed —
           the mega-menu already reaches all 28 in one click. -->
      <span class="w-px h-5 bg-slate-800 mx-1"></span>

      <!-- Other sections of the site -->
      <div class="relative" id="pdf-categories-menu-wrapper">
        <button id="pdf-categories-menu-btn" aria-haspopup="true" aria-expanded="false" class="flex items-center gap-1 text-slate-300 hover:text-white text-sm font-medium transition-colors px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-surface-hover)] whitespace-nowrap">
          More Tools
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        
        <div id="pdf-categories-menu-dropdown" class="hidden absolute right-0 top-full mt-2 w-[600px] max-w-[92vw] bg-[var(--bg-surface)] border border-slate-800 rounded-xl shadow-2xl overflow-hidden z-50">
          <div class="p-4 grid grid-cols-2 gap-3 bg-[var(--bg-surface)]">
            {SECTIONS.map(s => (
              <a href={s.path}
                class="flex items-start gap-3 p-2.5 rounded-lg hover:bg-[var(--bg-surface-hover)] border border-transparent hover:border-slate-800 transition-all group">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 text-lg transition-transform group-hover:scale-105" 
                  style={`background:rgba(${s.accentRgb},0.08); border: 1px solid rgba(${s.accentRgb},0.2)`}>
                  {s.icon}
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-bold text-white">{s.prefix}<span style={`color:${s.color}`}>{s.suffix}</span></span>
                    <span class="text-[10px] px-1.5 py-0.5 rounded-full font-medium" 
                      style={`background:rgba(${s.accentRgb},0.1); color:${s.color};`}>
                      {s.count}
                    </span>
                  </div>
                  <p class="text-slate-500 text-xs mt-0.5 leading-snug truncate group-hover:text-slate-400">{s.tagline}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="bg-[var(--bg-surface-hover)] border-t border-slate-800/80 px-4 py-2.5 flex justify-between items-center text-xs">
            <span class="text-slate-500">Fast, private, and 100% browser-based tools</span>
            <a href="/tools/" class="flex items-center gap-1 text-violet-400 hover:text-violet-300 font-medium transition-colors">
              View all tools ({toolsForSearch.length}) &rarr;
            </a>
          </div>
        </div>
      </div>

      <a href="/blog/" class="text-slate-300 hover:text-white transition-colors text-sm font-medium whitespace-nowrap px-2.5 py-1.5 rounded-lg hover:bg-[var(--bg-surface-hover)]">Blog</a>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2 shrink-0">
      <LanguageSwitcher alternates={alternates} locale="en" />

      <button id="pdf-theme-toggle" class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-[var(--bg-surface-hover)] transition-colors" aria-label="Toggle theme">
        <svg id="pdf-icon-sun" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z" />
        </svg>
        <svg id="pdf-icon-moon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile tool browser. Search finds a tool if you know its name; this
           is for the far more common case of not knowing it exists. Opens as a
           sheet so it costs no height in the sticky header. -->
      <button id="pdf-mobile-tools-btn" aria-haspopup="true" aria-expanded="false"
        class="md:hidden flex items-center gap-1 shrink-0 bg-[var(--bg-surface-hover)] hover:bg-[var(--bg-surface-alt)] text-slate-300 hover:text-white px-2.5 py-2 rounded-lg transition-colors text-sm font-medium"
        aria-label="Browse PDF tools">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h6v6H4V6zm10 0h6v6h-6V6zM4 16h6v4H4v-4zm10 0h6v4h-6v-4z"/></svg>
        <!-- Label drops below 400px so the wordmark keeps its full width; the
             icon plus aria-label still identify the control. -->
        <span class="hidden min-[400px]:inline">Tools</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>

      <!-- Search -->
      <button id="pdf-search-open" class="flex items-center gap-2 bg-[var(--bg-surface-hover)] hover:bg-[var(--bg-surface-alt)] text-slate-400 hover:text-white px-3 py-2 rounded-lg transition-colors text-sm" aria-label="Search tools">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <span class="hidden lg:inline">Search tools…</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile tool sheet -->
<!-- `top` is set from the measured header height on open; the rem fallback is
     only for the first paint, since the mobile header's pill row makes its
     height depend on content rather than being a fixed number. -->
<div id="pdf-mobile-tools-panel" class="hidden md:hidden fixed inset-x-0 bottom-0 z-40 bg-[var(--bg-base)] border-t border-slate-800 overflow-y-auto overscroll-contain" style="top:6.75rem">
  <div class="px-4 py-4 space-y-5">
    {GROUPS.map((g) => (
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wide mb-1.5" style={`color:${PDF_ICON_GROUPS[g.title]}`}>{g.title}</p>
        <ul class="grid grid-cols-2 gap-1.5">
          {g.slugs.map((slug) => (
            <li>
              <a href={`/pdfwonder/${slug}/`}
                class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] text-slate-300 bg-[var(--bg-surface)] border border-slate-800 active:bg-[var(--bg-surface-hover)]">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke={PDF_ICON_GROUPS[g.title]}
                  stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  set:html={PDF_ICONS[slug]} />
                <span class="leading-tight">{NAME[slug]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div class="pt-1 space-y-1.5">
      <a href="/pdfwonder/" class="block px-3 py-2 rounded-lg text-[13px] font-medium text-white bg-orange-600 text-center">All {PDF_TOOLS.length} PDF tools</a>
      <div class="grid grid-cols-2 gap-1.5">
        <a href="/" class="block px-3 py-2 rounded-lg text-[13px] text-slate-300 bg-[var(--bg-surface)] border border-slate-800 text-center">Home</a>
        <a href="/blog/" class="block px-3 py-2 rounded-lg text-[13px] text-slate-300 bg-[var(--bg-surface)] border border-slate-800 text-center">Blog</a>
      </div>
    </div>
  </div>
</div>

<!-- Search Modal -->
<div id="pdf-search-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="pdf-search-backdrop"></div>
  <div class="relative max-w-lg mx-auto mt-20 mx-4">
    <div class="bg-[var(--bg-surface)] border border-slate-700 rounded-2xl shadow-2xl overflow-hidden">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-slate-700">
        <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input id="pdf-search-input" type="text" placeholder="Search 150+ free tools…" class="flex-1 bg-transparent text-white placeholder-slate-500 outline-none text-base" autocomplete="off"/>
        <button id="pdf-search-close" class="text-slate-400 hover:text-white transition-colors text-sm">ESC</button>
      </div>
      <ul id="pdf-search-results" class="max-h-72 overflow-y-auto py-2"></ul>
    </div>
  </div>
</div>

<style>
  /* Custom scrollbar hiding helper */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
import { searchTools, loadSearchIndex } from '../lib/search.js';
  (function() {
    // Fetched on first use; see loadSearchIndex() in src/lib/search.js.
    let toolsForSearch = [];
    let searchIndexReady = false;
    function primeSearchIndex() {
      return loadSearchIndex().then((data) => { toolsForSearch = data; searchIndexReady = true; return data; });
    }

    // Theme
    const toggle = document.getElementById('pdf-theme-toggle');
    const sun = document.getElementById('pdf-icon-sun');
    const moon = document.getElementById('pdf-icon-moon');
    function applyTheme(t) {
      document.documentElement.setAttribute('data-theme', t);
      localStorage.setItem('tw-theme', t);
      if (t === 'dark') { sun.classList.remove('hidden'); moon.classList.add('hidden'); }
      else { sun.classList.add('hidden'); moon.classList.remove('hidden'); }
    }
    applyTheme(document.documentElement.getAttribute('data-theme') || 'dark');
    toggle.addEventListener('click', () => {
      applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });

    // Search
    const modal = document.getElementById('pdf-search-modal');
    const input = document.getElementById('pdf-search-input');
    const results = document.getElementById('pdf-search-results');
    const openBtn = document.getElementById('pdf-search-open');
    const closeBtn = document.getElementById('pdf-search-close');
    const backdrop = document.getElementById('pdf-search-backdrop');

    function openModal() { modal.classList.remove('hidden'); setTimeout(() => input.focus(), 50); renderResults(''); }
    function closeModal() { modal.classList.add('hidden'); input.value = ''; }

    openBtn.addEventListener('click', openModal);

    openBtn && openBtn.addEventListener('mouseenter', primeSearchIndex, { once: true });
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeModal();   // menus close via their own handler
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openModal(); }
    });

    function renderResults(query) {

      if (!searchIndexReady) { primeSearchIndex().then(() => renderResults(query)); return; }
      const q = query.toLowerCase().trim();
      const filtered = q 
        ? searchTools(toolsForSearch, q, 8)
        : toolsForSearch.slice(0, 8);
      results.innerHTML = filtered.length
        ? filtered.map(t => `<li><a href="${t.path}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-[var(--bg-surface-hover)] transition-colors"><div class="w-6 h-6 rounded flex items-center justify-center text-xs" style="background:${t.color}15;color:${t.color}">${t.icon || '⚙️'}</div><span class="text-white text-sm font-medium">${t.name}</span><span class="text-[10px] px-2 py-0.5 rounded-full font-medium ml-auto" style="background:${t.color}15;color:${t.color}">${t.category}</span></a></li>`).join('')
        : '<li class="px-4 py-4 text-slate-500 text-sm text-center">No tools found</li>';
    }
    input.addEventListener('input', e => renderResults(e.target.value));

    // Dropdowns. Opening one closes the other, Escape closes both, and the
    // button's aria-expanded tracks state for screen readers.
    const MENUS = [
      ['pdf-tools-menu-btn', 'pdf-tools-menu-dropdown'],
      ['pdf-categories-menu-btn', 'pdf-categories-menu-dropdown'],
      ['pdf-mobile-tools-btn', 'pdf-mobile-tools-panel'],
    ].map(([b, d]) => ({ btn: document.getElementById(b), panel: document.getElementById(d) }))
     .filter((m) => m.btn && m.panel);

    function closeMenus(except) {
      MENUS.forEach((m) => {
        if (m === except) return;
        m.panel.classList.add('hidden');
        m.btn.setAttribute('aria-expanded', 'false');
      });
    }
    const header = document.querySelector('header');
    MENUS.forEach((m) => {
      m.btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = m.panel.classList.contains('hidden');
        closeMenus(m);
        // Pin the mobile sheet to the real header height rather than guessing.
        if (willOpen && m.panel.id === 'pdf-mobile-tools-panel' && header) {
          m.panel.style.top = header.getBoundingClientRect().bottom + 'px';
        }
        m.panel.classList.toggle('hidden', !willOpen);
        m.btn.setAttribute('aria-expanded', String(willOpen));
        // Keep an absolutely-positioned panel inside the viewport. Measured
        // after it is shown, since a hidden element has no box to measure.
        if (willOpen && getComputedStyle(m.panel).position === 'absolute') {
          m.panel.style.left = '0px';
          const r = m.panel.getBoundingClientRect();
          const spill = r.right - (window.innerWidth - 16);
          if (spill > 0) m.panel.style.left = -spill + 'px';
        }
      });
    });
    document.addEventListener('click', (e) => {
      const inside = MENUS.some((m) => m.btn.contains(e.target) || m.panel.contains(e.target));
      if (!inside) closeMenus();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenus(); });
  })();
</script>
