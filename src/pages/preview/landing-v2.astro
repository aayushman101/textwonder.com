---
// ─────────────────────────────────────────────────────────────────────────────
// PREVIEW ONLY — not linked from anywhere, noindex, excluded from the sitemap.
// A full redesign of the TextWonder landing page in an editorial / bold-block
// theme inspired by buysellads.com: white paper, heavy display type, mono
// eyebrows, saturated solid colour blocks, and real motion on the tool suite.
// Live at /preview/landing-v2/ — delete the folder if it is not adopted.
// ─────────────────────────────────────────────────────────────────────────────
import { SECTIONS, getGlobalSearchIndex } from '../../data/categories.js';

const allTools = getGlobalSearchIndex();
const totalTools = allTools.length;

// The catalogue grid uses the v3 card treatment: white card, the suite's own
// colour as a top rule and numeral rather than a full-bleed fill. The saturated
// bold-block fills read well in isolation but turned the densest section of the
// page into eleven competing colour panels — as an accent the same palette
// stays legible and the tagline becomes readable again.
// Colours come straight from categories.js, which is where they already live.
const suites = SECTIONS.map((s) => ({
  key: `${s.prefix}${s.suffix}`,
  prefix: s.prefix,
  suffix: s.suffix,
  path: s.path,
  icon: s.icon,
  count: s.count,
  tagline: s.tagline,
  color: s.color,
}));

// Marquee rows: real tool names, sampled across every section so the band
// isn't 110 text tools followed by everything else.
const shuffled = [...allTools].sort((a, b) => (a.name.length % 7) - (b.name.length % 7));
const marquee = [
  shuffled.filter((_, i) => i % 3 === 0).slice(0, 26),
  shuffled.filter((_, i) => i % 3 === 1).slice(0, 26),
];

// The orbiting nodes in the hero, as % of the square stage box.
// Labelled chips are confined to the top and bottom bands (y < 20 / y > 80)
// so none of them can end up hidden behind the demo card, which occupies the
// middle. The unlabelled icon nodes fill the left and right flanks, where a
// full chip would either overlap the card or run off the stage.
const orbit = [
  { icon: '✍️', label: 'Word Counter',    x: 16, y: 13 },
  { icon: '🖼️', label: 'Compress Image',  x: 40, y: 4  },
  { icon: '📄', label: 'Merge PDF',       x: 69, y: 5  },
  { icon: '🛠️', label: 'JSON Formatter',  x: 84, y: 15 },
  { icon: '💾', label: 'CSV → JSON',      x: 14, y: 87 },
  { icon: '🎨', label: 'Contrast Check',  x: 38, y: 96 },
  { icon: '🧮', label: 'EMI Calculator',  x: 66, y: 88 },
  { icon: '🩺', label: 'BMI',             x: 88, y: 96 },
];
const orbitNodes = [
  { icon: '🎓', x: 5,  y: 36 },
  { icon: '📐', x: 4,  y: 66 },
  { icon: '🔤', x: 95, y: 38 },
  { icon: '⏱️', x: 96, y: 68 },
];

const stats = [
  { value: totalTools, suffix: '',  label: 'Tools, all free',      note: 'Across every suite',        bg: '#6B1235', fg: '#FFFFFF' },
  { value: 11,         suffix: '',  label: 'Tool suites',          note: 'Text to unit conversion',   bg: '#FFB400', fg: '#101014' },
  { value: 10,         suffix: '',  label: 'Languages',            note: 'Native URLs, not machine',  bg: '#B8E020', fg: '#101014' },
  { value: 0,          suffix: '',  label: 'Bytes uploaded',       note: 'Everything stays local',    bg: '#4B4BF7', fg: '#FFFFFF' },
];

const popular = [
  { n: '01', name: 'Word Counter',     path: '/tools/word-counter/',            suite: 'Text',  blurb: 'Live words, characters, sentences and reading time as you type.' },
  { n: '02', name: 'Merge PDF',        path: '/pdfwonder/pdf-merger/',          suite: 'PDF',   blurb: 'Combine and reorder any number of PDFs without an upload.' },
  { n: '03', name: 'JSON Formatter',   path: '/devwonder/json-formatter/',      suite: 'Dev',   blurb: 'Validate, pretty-print and collapse JSON with error positions.' },
  { n: '04', name: 'Image Compressor', path: '/imagewonder/image-compressor/',  suite: 'Image', blurb: 'Shrink JPG, PNG and WebP with a live quality preview.' },
  { n: '05', name: 'EMI Calculator',   path: '/calc/emi-calculator/',           suite: 'Calc',  blurb: 'Monthly instalment, total interest and full amortisation table.' },
  { n: '06', name: 'BMI Calculator',   path: '/health/bmi-calculator/',         suite: 'Health',blurb: 'Metric or imperial, with the healthy-weight range for your height.' },
];

const faqs = [
  { q: 'Is anything actually uploaded?', a: 'No. Every tool is JavaScript running in your own tab. Your text, PDFs and images are read by the browser, processed in memory and written back out — nothing is sent to a server, so there is nothing for us to store, log or leak.' },
  { q: 'Do I need an account?', a: 'There is no account, no email wall and no trial. Open a tool, use it, close the tab. Nothing is saved unless a tool explicitly offers to remember a setting in your own browser storage.' },
  { q: 'Is it free forever, or free for now?', a: 'Free. All 234 tools, all suites, no premium tier and no per-file limits. The site is supported by advertising, not by charging for the tools.' },
  { q: 'Does it work on a phone?', a: 'Yes — every tool is responsive and the file-based ones use the standard mobile file picker, so PDFs and images from your camera roll work the same way they do on desktop.' },
  { q: 'Will it work offline?', a: 'Most tools keep working once the page has loaded, because the processing is already on your device. The exceptions are the handful that call an external service, such as certain text-to-speech voices.' },
  { q: 'How big a file can I give it?', a: 'The limit is your device, not our plan. Browser memory is the only ceiling, which in practice means a few hundred megabytes on a modern laptop and rather less on an old phone.' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>TextWonder — 234 free tools that never see your data (design preview)</title>
  <meta name="description" content="Design preview of a redesigned TextWonder landing page." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
<style>
/* ─── tokens ──────────────────────────────────────────────────────────────── */
:root{
  --ink:#101014;
  --ink-2:#3B3B46;
  --ink-3:#6E6E7C;
  --paper:#FFFFFF;
  --paper-2:#F6F2E9;
  --paper-3:#EFEAE0;
  --line:#E3DED2;
  --orange:#F04E23;
  --wine:#6B1235;
  --amber:#FFB400;
  --lime:#B8E020;
  --indigo:#4B4BF7;
  --teal:#0E7C6B;
  --lilac:#C9B6F7;
  --sky:#7FD4E8;
  --rose:#E2456B;

  --display:"Bricolage Grotesque","Inter",system-ui,sans-serif;
  --body:"Inter",system-ui,-apple-system,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,monospace;

  --shell:1240px;
  --pad:clamp(20px,4vw,48px);
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--body);font-size:17px;line-height:1.6;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
h1,h2,h3,h4{font-family:var(--display);font-weight:800;letter-spacing:-.03em;line-height:1.03;margin:0}
p{margin:0}
ul{margin:0;padding:0;list-style:none}

.shell{max-width:var(--shell);margin:0 auto;padding-inline:var(--pad)}
.eyebrow{
  font-family:var(--mono);font-size:12px;font-weight:500;
  letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);
}

/* ─── announcement ────────────────────────────────────────────────────────── */
.announce{
  background:var(--orange);color:#fff;font-family:var(--mono);
  font-size:13px;letter-spacing:.02em;text-align:center;padding:11px 16px;
}
.announce a{font-weight:700;text-decoration:underline;text-underline-offset:3px}

/* ─── header ──────────────────────────────────────────────────────────────── */
.masthead{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.88);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.masthead-in{display:flex;align-items:center;gap:28px;height:74px}
.wordmark{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:800;font-size:22px;letter-spacing:-.04em}
.dot{width:11px;height:11px;border-radius:99px;background:var(--orange);flex:none}
.nav{display:flex;gap:26px;margin-left:auto;font-family:var(--mono);font-size:13px;letter-spacing:.04em}
.nav a{position:relative;padding:4px 0;color:var(--ink-2)}
.nav a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:2px;background:var(--orange);transition:right .28s cubic-bezier(.2,.8,.2,1)}
.nav a:hover{color:var(--ink)}
.nav a:hover::after{right:0}

.btn{
  display:inline-flex;align-items:center;gap:9px;font-family:var(--body);
  font-weight:600;font-size:15px;padding:13px 22px;border-radius:999px;
  border:1.5px solid transparent;white-space:nowrap;cursor:pointer;
  transition:transform .18s ease,background .18s ease,color .18s ease,border-color .18s ease;
}
.btn:hover{transform:translateY(-2px)}
.btn-dark{background:var(--ink);color:#fff}
.btn-dark:hover{background:var(--orange)}
.btn-orange{background:var(--orange);color:#fff;box-shadow:0 10px 26px -12px rgba(240,78,35,.85)}
.btn-orange:hover{background:var(--ink);box-shadow:0 12px 30px -12px rgba(16,16,20,.6)}
.btn-ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
.btn-ghost:hover{background:var(--ink);color:#fff}
.btn-lg{font-size:16px;padding:16px 28px}
.arrow{transition:transform .18s ease}
.btn:hover .arrow{transform:translate(3px,-3px)}

/* ─── hero ────────────────────────────────────────────────────────────────── */
.hero{position:relative;overflow:hidden;background:
  radial-gradient(900px 460px at 78% 4%, #FFF3EE 0%, rgba(255,255,255,0) 70%),
  radial-gradient(700px 420px at 4% 92%, #F3F6E4 0%, rgba(255,255,255,0) 70%);}
/* padding-block, not the `padding` shorthand — .hero-grid shares its element
   with .shell, and a shorthand would zero out the shell's inline padding. */
.hero-grid{display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,1fr);gap:clamp(28px,5vw,64px);align-items:center;padding-block:clamp(40px,5.5vw,72px) clamp(36px,4.5vw,60px)}
.hero h1{font-size:clamp(38px,5.4vw,68px);margin:18px 0 20px;max-width:17ch}
.hero h1 em{font-style:normal;color:var(--orange)}
.hero h1 .strike{position:relative;white-space:nowrap}
.hero h1 .strike::after{content:"";position:absolute;left:-2%;right:-2%;top:56%;height:.08em;background:var(--orange);transform:scaleX(0);transform-origin:left;animation:strike .7s cubic-bezier(.65,0,.35,1) 1.1s forwards}
@keyframes strike{to{transform:scaleX(1)}}
.hero-sub{font-size:clamp(17px,1.5vw,20px);color:var(--ink-2);max-width:47ch;margin-bottom:30px}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:26px}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3)}
.hero-meta span{display:inline-flex;align-items:center;gap:7px}
.tick{width:14px;height:14px;flex:none;color:var(--orange)}

/* ─── hero stage: orbiting chips + live demo card ─────────────────────────── */
.stage{position:relative;aspect-ratio:1/1;width:100%;max-width:560px;margin-inline:auto}
.stage-lines{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.stage-lines line{stroke:#D8D2C6;stroke-width:1;stroke-dasharray:4 6;animation:crawl 9s linear infinite}
@keyframes crawl{to{stroke-dashoffset:-100}}

.chip{
  position:absolute;translate:-50% -50%;
  display:inline-flex;align-items:center;gap:8px;
  background:#fff;border:1.5px solid var(--ink);border-radius:999px;
  padding:8px 14px;font-family:var(--mono);font-size:12px;font-weight:500;
  white-space:nowrap;box-shadow:4px 4px 0 rgba(16,16,20,.08);
  animation:bob 6s ease-in-out infinite;will-change:transform;
  transition:background .25s,color .25s,box-shadow .25s;
}
.chip .em{font-size:14px;line-height:1}
.chip.is-live{background:var(--ink);color:#fff;box-shadow:4px 4px 0 var(--orange)}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}

.node{
  position:absolute;translate:-50% -50%;
  width:46px;height:46px;border-radius:50%;background:#fff;
  border:1.5px solid var(--ink);display:grid;place-items:center;font-size:19px;
  box-shadow:3px 3px 0 rgba(16,16,20,.08);
  animation:bob 7s ease-in-out infinite;will-change:transform;
}

.demo{
  position:absolute;left:50%;top:50%;translate:-50% -50%;
  width:min(88%,392px);background:var(--ink);color:#fff;border-radius:20px;
  padding:18px;box-shadow:0 40px 80px -40px rgba(16,16,20,.6);
}
.demo-bar{display:flex;align-items:center;gap:7px;margin-bottom:15px}
.demo-bar i{width:9px;height:9px;border-radius:99px;background:#3A3A46;display:block}
.demo-bar i:first-child{background:var(--orange)}
.demo-tag{margin-left:auto;font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:#8A8A99}
.demo-title{font-family:var(--display);font-weight:700;font-size:20px;letter-spacing:-.02em;margin-bottom:12px;display:flex;align-items:center;gap:9px}
.demo-io{
  background:#1A1A21;border:1px solid #26262F;border-radius:12px;padding:13px 14px;
  font-family:var(--mono);font-size:12.5px;line-height:1.55;color:#C7C7D2;
  min-height:80px;word-break:break-word;white-space:pre-wrap;
}
.caret{display:inline-block;width:8px;height:14px;background:var(--orange);vertical-align:-2px;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
.demo-chips{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.demo-chip{background:#1A1A21;border:1px solid #26262F;border-radius:10px;padding:10px 6px;text-align:center;opacity:0;transform:translateY(8px);transition:opacity .35s ease,transform .35s ease}
.demo-chip.in{opacity:1;transform:none}
.demo-chip b{display:block;font-family:var(--display);font-size:18px;font-weight:800;letter-spacing:-.02em;color:var(--orange);white-space:nowrap}
.demo-chip span{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:#7E7E8C;text-transform:uppercase}
.demo-progress{height:2px;background:#26262F;border-radius:2px;margin-top:14px;overflow:hidden}
.demo-progress i{display:block;height:100%;width:0;background:var(--orange)}

/* ─── marquee band ────────────────────────────────────────────────────────── */
.band{background:var(--ink);color:#fff;padding:30px 0;overflow:hidden}
.band-label{text-align:center;font-family:var(--mono);font-size:11px;letter-spacing:.2em;color:#7E7E8C;text-transform:uppercase;margin-bottom:22px}
.track{display:flex;width:max-content;gap:12px;padding-block:6px}
.track-a{animation:slide-l 62s linear infinite}
.track-b{animation:slide-r 74s linear infinite;margin-top:12px}
@keyframes slide-l{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes slide-r{from{transform:translateX(-50%)}to{transform:translateX(0)}}
.band:hover .track{animation-play-state:paused}
.tchip{
  border:1px solid #2C2C36;border-radius:999px;padding:8px 16px;
  font-family:var(--mono);font-size:12.5px;color:#B9B9C6;white-space:nowrap;
  transition:background .2s,color .2s,border-color .2s;
}
.tchip:hover{background:var(--orange);border-color:var(--orange);color:#fff}

/* ─── section scaffolding ─────────────────────────────────────────────────── */
.sec{padding:clamp(60px,8vw,108px) 0}
.sec-head{max-width:64ch;margin-bottom:clamp(30px,4vw,50px)}
.sec-head h2{font-size:clamp(33px,4.4vw,58px);margin:14px 0 16px}
.sec-head p{color:var(--ink-2);font-size:clamp(16px,1.4vw,19px);max-width:56ch}

/* ─── stats ───────────────────────────────────────────────────────────────── */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.stat{border-radius:18px;padding:24px 22px 22px;min-height:206px;display:flex;flex-direction:column;justify-content:space-between}
.stat .k{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.75}
.stat .v{font-family:var(--display);font-size:clamp(46px,5.4vw,70px);font-weight:800;letter-spacing:-.05em;line-height:1}
.stat .l{font-weight:600;font-size:17px;margin-top:6px}
.stat .n{font-family:var(--mono);font-size:11px;letter-spacing:.06em;opacity:.72;margin-top:4px}

/* ─── suites grid (v3 card treatment) ─────────────────────────────────────
   Three things carry the suite's colour — the top rule, the count numeral and
   the hover state — instead of a full-bleed fill. Eleven saturated panels in a
   row fought each other; as an accent the same palette reads as a spectrum. */
.suites{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.suite{
  position:relative;background:var(--paper);border:1px solid var(--line);
  border-radius:16px;padding:22px 20px 18px;overflow:hidden;
  display:flex;flex-direction:column;min-height:210px;
  transition:border-color .18s,transform .18s,box-shadow .18s;
}
.suite::before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--c)}
.suite:hover{border-color:var(--ink);transform:translateY(-3px);box-shadow:0 22px 44px -28px rgba(16,16,20,.5)}
.suite-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px}
.suite-icon{font-size:20px;line-height:1}
.suite-count{font-family:var(--display);font-size:30px;font-weight:800;letter-spacing:-.05em;line-height:.9;color:var(--c)}
.suite h3{font-size:19px;letter-spacing:-.035em;margin-bottom:8px}
.suite h3 span{color:var(--c)}
.suite p{
  font-size:13.8px;line-height:1.5;color:var(--ink-2);margin-bottom:14px;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
}
.suite-go{margin-top:auto;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);transition:color .18s}
.suite:hover .suite-go{color:var(--c)}

/* 11 suites in a 4-column grid leave one cell open; the catalogue link fills
   it rather than leaving a hole. */
.suite-all{
  background:transparent;border:1.5px dashed var(--ink);
  justify-content:center;gap:4px;
}
.suite-all::before{display:none}
.suite-all-num{font-family:var(--display);font-size:44px;font-weight:800;letter-spacing:-.05em;line-height:1;color:var(--orange)}
.suite-all-txt{font-family:var(--display);font-size:18px;font-weight:700;letter-spacing:-.02em;line-height:1.25}
.suite-all:hover{background:var(--ink);color:#fff;border-style:solid}
.suite-all:hover .suite-all-num{color:#fff}

/* ─── privacy explainer ───────────────────────────────────────────────────── */
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(28px,5vw,68px);align-items:center}
.flow{background:var(--paper-2);border:1px solid var(--line);border-radius:22px;padding:clamp(20px,3vw,32px)}
.flow-row{display:flex;align-items:center;gap:12px}
.flow-node{flex:1;background:#fff;border:1.5px solid var(--ink);border-radius:14px;padding:16px 12px;text-align:center}
.flow-node .em{font-size:23px}
.flow-node b{display:block;font-family:var(--display);font-size:15px;margin-top:8px}
.flow-node span{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3)}
.flow-arrow{font-family:var(--mono);color:var(--ink-3);flex:none;font-size:14px}
.flow-cut{margin-top:18px;display:flex;align-items:center;gap:12px;border:1.5px dashed var(--rose);border-radius:14px;padding:14px 16px;background:rgba(226,69,107,.06)}
.flow-cut .em{font-size:20px}
.flow-cut b{font-family:var(--display);font-size:15px;display:block}
.flow-cut p{font-size:13.5px;color:var(--ink-2)}
.checks{display:grid;gap:16px;margin-top:26px}
.check{display:flex;gap:13px;align-items:flex-start}
.check .box{width:26px;height:26px;border-radius:8px;background:var(--ink);color:#fff;display:grid;place-items:center;flex:none;font-size:13px}
.check b{font-family:var(--display);font-size:17px;display:block;margin-bottom:2px}
.check p{font-size:15px;color:var(--ink-2)}

/* ─── popular list ────────────────────────────────────────────────────────── */
.plist{border-top:1px solid var(--line)}
.prow{display:grid;grid-template-columns:64px minmax(0,1.05fr) minmax(0,1.45fr) auto;gap:20px;align-items:center;padding:22px 8px;border-bottom:1px solid var(--line);transition:background .22s,padding .22s}
.prow:hover{background:var(--paper-2);padding-inline:18px}
.prow .num{font-family:var(--mono);font-size:12px;color:var(--ink-3);letter-spacing:.1em}
.prow .nm{font-family:var(--display);font-size:clamp(20px,2.2vw,27px);font-weight:700;letter-spacing:-.03em}
.prow .bl{color:var(--ink-2);font-size:15px}
.prow .sf{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--line);border-radius:99px;padding:5px 10px;color:var(--ink-3)}
.prow:hover .sf{border-color:var(--ink);color:var(--ink)}

/* ─── faq ─────────────────────────────────────────────────────────────────── */
.faq{border-top:1px solid var(--line)}
.faq details{border-bottom:1px solid var(--line)}
.faq summary{
  list-style:none;cursor:pointer;display:flex;align-items:center;gap:18px;
  padding:24px 4px;font-family:var(--display);font-weight:700;
  font-size:clamp(18px,2vw,24px);letter-spacing:-.02em;
}
.faq summary::-webkit-details-marker{display:none}
.faq summary .sign{margin-left:auto;font-family:var(--mono);font-size:22px;color:var(--orange);transition:transform .25s;flex:none}
.faq details[open] summary .sign{transform:rotate(45deg)}
.faq .ans{padding:0 60px 26px 4px;color:var(--ink-2);font-size:16.5px;max-width:78ch}

/* ─── closing cta ─────────────────────────────────────────────────────────── */
.close-cta{background:var(--orange);color:#fff;border-radius:26px;padding:clamp(38px,6vw,74px);text-align:center}
.close-cta h2{font-size:clamp(33px,5.2vw,64px);max-width:19ch;margin:0 auto 18px}
.close-cta p{max-width:52ch;margin:0 auto 30px;font-size:18px;opacity:.94}
.close-cta .btn-dark:hover{background:#fff;color:var(--orange)}
.close-cta .btn-ghost{border-color:#fff;color:#fff}
.close-cta .btn-ghost:hover{background:#fff;color:var(--orange)}

/* ─── footer ──────────────────────────────────────────────────────────────── */
.foot{border-top:1px solid var(--line);padding:56px 0 40px;margin-top:clamp(60px,8vw,110px)}
.foot-grid{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:32px}
.foot h4{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);margin-bottom:14px}
.foot li{margin-bottom:9px;font-size:15px;color:var(--ink-2)}
.foot li a:hover{color:var(--orange)}
.foot-bot{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center;margin-top:44px;padding-top:22px;border-top:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--ink-3)}

/* ─── scroll reveal ───────────────────────────────────────────────────────── */
.rv{opacity:0;transform:translateY(22px);transition:opacity .7s cubic-bezier(.2,.8,.2,1),transform .7s cubic-bezier(.2,.8,.2,1)}
.rv.in{opacity:1;transform:none}

/* ─── responsive ──────────────────────────────────────────────────────────── */
@media (max-width:1080px){
  .suites{grid-template-columns:repeat(3,1fr)}
  .stats{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:860px){
  .suites{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:920px){
  .hero-grid{grid-template-columns:1fr;padding-top:44px}
  .stage{max-width:470px;margin-top:14px}
  .split{grid-template-columns:1fr}
  .nav{display:none}
  .prow{grid-template-columns:40px 1fr;gap:4px 14px}
  .prow .bl{grid-column:2}
  .prow .sf{grid-column:2;justify-self:start;margin-top:6px}
}
@media (max-width:620px){
  body{font-size:16px}
  .suites{grid-template-columns:repeat(2,1fr)}
  .suite{min-height:0}
  .suite p{-webkit-line-clamp:2}
  .stats{grid-template-columns:1fr}
  .foot-grid{grid-template-columns:1fr 1fr}
  /* Below ~620px the square stage is smaller than the demo card needs, so the
     orbit would sit underneath it. Drop the constellation and let the card
     stand on its own — the marquee band right below still carries the motion. */
  .stage{aspect-ratio:auto;max-width:430px}
  .stage-lines,.chip,.node{display:none}
  .demo{position:static;translate:none;width:100%}
  .faq .ans{padding-right:16px}
  .flow-row{flex-direction:column;align-items:stretch}
  .flow-arrow{text-align:center}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  .rv{opacity:1;transform:none}
}
</style>
</head>
<body>

<!-- ── announcement ─────────────────────────────────────────────────────── -->
<div class="announce">
  Design preview — this page is not linked or indexed. <a href="/">Back to the live site →</a>
</div>

<!-- ── masthead ─────────────────────────────────────────────────────────── -->
<header class="masthead">
  <div class="shell masthead-in">
    <a href="/" class="wordmark"><span class="dot"></span>TextWonder</a>
    <nav class="nav">
      <a href="#suites">Suites</a>
      <a href="#privacy">Privacy</a>
      <a href="#popular">Popular</a>
      <a href="#faq">FAQ</a>
      <a href="/blog/">Blog</a>
    </nav>
    <a href="/tools/" class="btn btn-dark">Browse all tools <span class="arrow">↗</span></a>
  </div>
</header>

<main>

<!-- ── hero ─────────────────────────────────────────────────────────────── -->
<section class="hero">
  <div class="shell hero-grid">
    <div>
      <p class="eyebrow">{suites.length} suites · {totalTools} tools · zero uploads</p>
      <h1>
        Every tool you need.<br />
        <em>None</em> of your <span class="strike">data</span> leaves the tab.
      </h1>
      <p class="hero-sub">
        Word counters, PDF merging, image compression, JSON, EMI, BMI, unit conversion —
        {totalTools} utilities that run as JavaScript inside your own browser.
        No account, no queue, no file ever reaching a server.
      </p>
      <div class="hero-cta">
        <a href="/tools/" class="btn btn-orange btn-lg">Start with any tool <span class="arrow">↗</span></a>
        <a href="#privacy" class="btn btn-ghost btn-lg">How the privacy works</a>
      </div>
      <div class="hero-meta">
        <span><svg class="tick" viewBox="0 0 20 20" fill="currentColor"><path d="M7.6 14.2 3.8 10.4l1.4-1.4 2.4 2.4 7-7 1.4 1.4z"/></svg>Free forever</span>
        <span><svg class="tick" viewBox="0 0 20 20" fill="currentColor"><path d="M7.6 14.2 3.8 10.4l1.4-1.4 2.4 2.4 7-7 1.4 1.4z"/></svg>No signup</span>
        <span><svg class="tick" viewBox="0 0 20 20" fill="currentColor"><path d="M7.6 14.2 3.8 10.4l1.4-1.4 2.4 2.4 7-7 1.4 1.4z"/></svg>Works on mobile</span>
      </div>
    </div>

    <!-- animated stage -->
    <div class="stage" id="stage">
      <svg class="stage-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {[...orbit, ...orbitNodes].map((o) => <line x1={o.x} y1={o.y} x2="50" y2="50" />)}
      </svg>

      {orbit.map((o, i) => (
        <span class="chip" data-chip={i} style={`left:${o.x}%;top:${o.y}%;animation-delay:${(i * 0.45).toFixed(2)}s`}>
          <span class="em">{o.icon}</span>{o.label}
        </span>
      ))}

      {orbitNodes.map((o, i) => (
        <span class="node" style={`left:${o.x}%;top:${o.y}%;animation-delay:${(i * 0.7 + 0.3).toFixed(2)}s`} aria-hidden="true">{o.icon}</span>
      ))}

      <div class="demo" aria-live="polite">
        <div class="demo-bar">
          <i></i><i></i><i></i>
          <span class="demo-tag" id="demo-tag">TEXTWONDER</span>
        </div>
        <div class="demo-title"><span id="demo-icon">✍️</span><span id="demo-name">Word Counter</span></div>
        <div class="demo-io" id="demo-io"></div>
        <div class="demo-chips" id="demo-chips">
          <div class="demo-chip"><b>—</b><span>—</span></div>
          <div class="demo-chip"><b>—</b><span>—</span></div>
          <div class="demo-chip"><b>—</b><span>—</span></div>
        </div>
        <div class="demo-progress"><i id="demo-bar"></i></div>
      </div>
    </div>
  </div>
</section>

<!-- ── marquee band ─────────────────────────────────────────────────────── -->
<section class="band" aria-hidden="true">
  <p class="band-label">A working tool for the thing you were about to google</p>
  <div class="track track-a">
    {[...marquee[0], ...marquee[0]].map((t) => <a class="tchip" href={t.path} tabindex="-1">{t.name}</a>)}
  </div>
  <div class="track track-b">
    {[...marquee[1], ...marquee[1]].map((t) => <a class="tchip" href={t.path} tabindex="-1">{t.name}</a>)}
  </div>
</section>


<!-- ── stats ────────────────────────────────────────────────────────────── -->
<section class="sec">
  <div class="shell">
    <div class="sec-head rv">
      <p class="eyebrow">By the numbers</p>
      <h2>Big enough to be useful. Small enough to trust.</h2>
      <p>One codebase, no backend for tool processing, and a hard rule that nothing you paste or open is transmitted anywhere.</p>
    </div>
    <div class="stats">
      {stats.map((s) => (
        <div class="stat rv" style={`background:${s.bg};color:${s.fg}`}>
          <span class="k">Outcome</span>
          <div>
            <div class="v" data-count={s.value}>0</div>
            <div class="l">{s.label}</div>
            <div class="n">{s.note}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── suites ───────────────────────────────────────────────────────────── -->
<section class="sec" id="suites" style="background:var(--paper-2)">
  <div class="shell">
    <div class="sec-head rv">
      <p class="eyebrow">The catalogue</p>
      <h2>Eleven suites, one tab.</h2>
      <p>Each suite is a full set — not a teaser with the useful half behind a paywall. Pick the corner of the site that matches the job.</p>
    </div>
    <div class="suites">
      {suites.map((s) => (
        <a class="suite rv" href={s.path} style={`--c:${s.color}`}>
          <span class="suite-top">
            <span class="suite-icon">{s.icon}</span>
            <span class="suite-count">{s.count}</span>
          </span>
          <h3>{s.prefix}<span>{s.suffix}</span></h3>
          <p>{s.tagline}</p>
          <span class="suite-go">{s.count} tools →</span>
        </a>
      ))}

      <a class="suite suite-all rv" href="/tools/">
        <span class="suite-all-num">{totalTools}</span>
        <span class="suite-all-txt">tools in total.<br />See the whole catalogue <span class="arrow">↗</span></span>
      </a>
    </div>
  </div>
</section>


<!-- ── privacy explainer ────────────────────────────────────────────────── -->
<section class="sec" id="privacy">
  <div class="shell split">
    <div class="rv">
      <p class="eyebrow">Why it is private</p>
      <h2 style="font-size:clamp(32px,4.2vw,54px);margin:14px 0 16px">There is no upload step to worry about.</h2>
      <p style="color:var(--ink-2);font-size:18px">
        Most "online" tools are a form that posts your file to someone else's machine.
        TextWonder skips that middle box entirely — the browser already has a PDF engine,
        an image decoder and a JSON parser, so we use those.
      </p>
      <div class="checks">
        <div class="check">
          <span class="box">✓</span>
          <div><b>Nothing to breach</b><p>We never hold your file, so there is no bucket for anyone to find later.</p></div>
        </div>
        <div class="check">
          <span class="box">✓</span>
          <div><b>Nothing to wait for</b><p>No round trip means results appear as fast as your laptop can compute them.</p></div>
        </div>
        <div class="check">
          <span class="box">✓</span>
          <div><b>Nothing to sign up for</b><p>No account exists because there is no server-side state to attach one to.</p></div>
        </div>
      </div>
    </div>

    <div class="flow rv">
      <p class="eyebrow" style="margin-bottom:16px">What actually happens</p>
      <div class="flow-row">
        <div class="flow-node"><span class="em">📄</span><b>Your file</b><span>On your disk</span></div>
        <span class="flow-arrow">──▶</span>
        <div class="flow-node"><span class="em">🖥️</span><b>Your browser</b><span>Processes it</span></div>
        <span class="flow-arrow">──▶</span>
        <div class="flow-node"><span class="em">⬇️</span><b>Your result</b><span>Downloads</span></div>
      </div>
      <div class="flow-cut">
        <span class="em">🚫</span>
        <div><b>The step everyone else has</b><p>Upload → server queue → storage → download link → retention policy.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- ── popular ──────────────────────────────────────────────────────────── -->
<section class="sec" id="popular">
  <div class="shell">
    <div class="sec-head rv">
      <p class="eyebrow">Most used</p>
      <h2>Where most people start.</h2>
    </div>
    <div class="plist">
      {popular.map((p) => (
        <a class="prow rv" href={p.path}>
          <span class="num">{p.n}</span>
          <span class="nm">{p.name}</span>
          <span class="bl">{p.blurb}</span>
          <span class="sf">{p.suite}</span>
        </a>
      ))}
    </div>
    <p style="margin-top:26px">
      <a href="/tools/" class="btn btn-ghost">See all {totalTools} tools <span class="arrow">↗</span></a>
    </p>
  </div>
</section>


<!-- ── faq ──────────────────────────────────────────────────────────────── -->
<section class="sec" id="faq" style="background:var(--paper-2)">
  <div class="shell">
    <div class="sec-head rv">
      <p class="eyebrow">Questions</p>
      <h2>The six we get asked most.</h2>
    </div>
    <div class="faq rv">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}<span class="sign">+</span></summary>
          <div class="ans">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ── closing cta ──────────────────────────────────────────────────────── -->
<section style="padding-bottom:clamp(20px,4vw,40px)">
  <div class="shell">
    <div class="close-cta rv">
      <p class="eyebrow" style="color:rgba(255,255,255,.8)">No account. No upload. No cost.</p>
      <h2 style="margin-top:14px">Open a tool. It works before you finish reading this.</h2>
      <p>{totalTools} tools across {suites.length} suites, in 10 languages, all running on your own machine.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/tools/" class="btn btn-dark btn-lg">Browse the catalogue <span class="arrow">↗</span></a>
        <a href="/tools/word-counter/" class="btn btn-ghost btn-lg">Try the word counter</a>
      </div>
    </div>
  </div>
</section>

</main>

<!-- ── footer ───────────────────────────────────────────────────────────── -->
<footer class="foot">
  <div class="shell">
    <div class="foot-grid">
      <div>
        <a href="/" class="wordmark" style="margin-bottom:14px"><span class="dot"></span>TextWonder</a>
        <p style="color:var(--ink-2);font-size:15px;max-width:34ch">
          {totalTools} free browser-based tools. Nothing you open is uploaded, stored or logged.
        </p>
      </div>
      <div>
        <h4>Popular suites</h4>
        <ul>
          {suites.slice(0, 5).map((s) => <li><a href={s.path}>{s.key}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>More suites</h4>
        <ul>
          {suites.slice(5).map((s) => <li><a href={s.path}>{s.key}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bot">
      <span>© {new Date().getFullYear()} TextWonder — design preview</span>
      <span>Made in the browser, for the browser</span>
    </div>
  </div>
</footer>

<script is:inline>
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── scroll reveal ─────────────────────────────────────────────────── */
  var revealables = document.querySelectorAll('.rv');
  if (reduce || !('IntersectionObserver' in window)) {
    revealables.forEach(function (el) { el.classList.add('in'); });
  } else {
    var groups = new Map();
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var parent = e.target.parentElement;
        var seen = groups.get(parent) || 0;
        groups.set(parent, seen + 1);
        e.target.style.transitionDelay = Math.min(seen, 6) * 70 + 'ms';
        e.target.classList.add('in');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
    revealables.forEach(function (el) { io.observe(el); });
  }

  /* ── count-up stats ────────────────────────────────────────────────── */
  var counters = document.querySelectorAll('[data-count]');
  var runCount = function (el) {
    var target = parseInt(el.getAttribute('data-count'), 10) || 0;
    if (reduce || target === 0) { el.textContent = String(target); return; }
    var start = performance.now();
    var dur = 1100;
    var step = function (now) {
      var t = Math.min(1, (now - start) / dur);
      var eased = 1 - Math.pow(1 - t, 3);
      el.textContent = String(Math.round(target * eased));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if ('IntersectionObserver' in window) {
    var cio = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        runCount(e.target);
        cio.unobserve(e.target);
      });
    }, { threshold: 0.4 });
    counters.forEach(function (el) { cio.observe(el); });
  } else {
    counters.forEach(runCount);
  }

  /* ── hero: cycling live tool demo ──────────────────────────────────── */
  var DEMOS = [
    {
      tag: 'TEXTWONDER', icon: '✍️', name: 'Word Counter', chip: 0,
      io: 'The quick brown fox jumps over the lazy dog, and the counter keeps up with every keystroke.',
      out: [['128', 'words'], ['612', 'chars'], ['1 min', 'read']]
    },
    {
      tag: 'PDFWONDER', icon: '📄', name: 'Merge PDF', chip: 1,
      io: 'report.pdf + invoice.pdf + notes.pdf\n→ merged-2026-08.pdf',
      out: [['3', 'files in'], ['1', 'file out'], ['0 KB', 'uploaded']]
    },
    {
      tag: 'DEVWONDER', icon: '🛠️', name: 'JSON Formatter', chip: 2,
      io: '{"id":42,"ok":true,"tags":["fast","local"]}',
      out: [['✓', 'valid'], ['4', 'keys'], ['11 ms', 'parse']]
    },
    {
      tag: 'IMAGEWONDER', icon: '🖼️', name: 'Image Compressor', chip: 3,
      io: 'photo-4032x3024.jpg — 4.8 MB\n→ photo-compressed.webp',
      out: [['612 KB', 'new size'], ['87%', 'smaller'], ['92', 'quality']]
    },
    {
      tag: 'CALCWONDER', icon: '🧮', name: 'EMI Calculator', chip: 4,
      io: '₹12,00,000 · 8.5% p.a. · 60 months',
      out: [['₹24,617', 'per month'], ['₹2.77L', 'interest'], ['60', 'payments']]
    },
    {
      tag: 'COLORWONDER', icon: '🎨', name: 'Contrast Checker', chip: 5,
      io: '#F04E23 on #FFFFFF — body text, 17px',
      out: [['3.42:1', 'ratio'], ['AA', 'large text'], ['✓', 'ui pass']]
    }
  ];

  var elTag = document.getElementById('demo-tag');
  var elIcon = document.getElementById('demo-icon');
  var elName = document.getElementById('demo-name');
  var elIO = document.getElementById('demo-io');
  var elBar = document.getElementById('demo-bar');
  var chipEls = document.querySelectorAll('#demo-chips .demo-chip');
  var orbitChips = document.querySelectorAll('.chip');
  var HOLD = 4200;
  var idx = -1;
  var timers = [];

  var running = false;

  var clear = function () { timers.forEach(clearTimeout); timers = []; running = false; };
  var later = function (fn, ms) { timers.push(setTimeout(fn, ms)); };

  var paint = function (d) {
    elTag.textContent = d.tag;
    elIcon.textContent = d.icon;
    elName.textContent = d.name;
    orbitChips.forEach(function (c, i) { c.classList.toggle('is-live', i === d.chip); });
    chipEls.forEach(function (c, i) {
      c.classList.remove('in');
      c.querySelector('b').textContent = d.out[i][0];
      c.querySelector('span').textContent = d.out[i][1];
    });
  };

  var type = function (text, done) {
    if (reduce) { elIO.textContent = text; done(); return; }
    var i = 0;
    var tick = function () {
      i += Math.random() < 0.25 ? 2 : 1;
      elIO.innerHTML = '';
      elIO.appendChild(document.createTextNode(text.slice(0, i)));
      var caret = document.createElement('span');
      caret.className = 'caret';
      elIO.appendChild(caret);
      if (i < text.length) later(tick, 18);
      else later(done, 260);
    };
    tick();
  };

  var advance = function () {
    clear();
    running = true;
    idx = (idx + 1) % DEMOS.length;
    var d = DEMOS[idx];
    paint(d);
    elBar.style.transition = 'none';
    elBar.style.width = '0%';
    type(d.io, function () {
      chipEls.forEach(function (c, i) { later(function () { c.classList.add('in'); }, i * 110); });
      later(function () {
        elBar.style.transition = 'width ' + HOLD + 'ms linear';
        elBar.style.width = '100%';
      }, 40);
      later(advance, HOLD);
    });
  };

  var stage = document.getElementById('stage');
  if (stage) {
    if ('IntersectionObserver' in window) {
      var sio = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            // Re-entering replays the demo that was interrupted, rather than
            // skipping one — advance() increments, so step back first.
            if (!running) { idx = Math.max(idx - 1, -1); advance(); }
          } else {
            clear();
          }
        });
      }, { threshold: 0.15 });
      sio.observe(stage);
    } else {
      advance();
    }
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) clear();
    });
  }
})();
</script>
</body>
</html>
