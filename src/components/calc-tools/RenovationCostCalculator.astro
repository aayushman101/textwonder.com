---
---

<div>
  <!-- Presets -->
  <div class="mb-4">
    <label class="block text-sm text-slate-400 mb-2">Quick Examples:</label>
    <div class="flex flex-wrap gap-2">
      <button data-preset="kitchen" class="px-3 py-1.5 text-xs bg-[var(--bg-base)] border border-slate-700 text-slate-300 hover:text-white hover:border-emerald-500 rounded-lg transition-colors">🍳 Kitchen</button>
      <button data-preset="bathroom" class="px-3 py-1.5 text-xs bg-[var(--bg-base)] border border-slate-700 text-slate-300 hover:text-white hover:border-emerald-500 rounded-lg transition-colors">🚿 Bathroom</button>
      <button data-preset="bedroom" class="px-3 py-1.5 text-xs bg-[var(--bg-base)] border border-slate-700 text-slate-300 hover:text-white hover:border-emerald-500 rounded-lg transition-colors">🛏️ Bedroom</button>
      <button data-preset="living" class="px-3 py-1.5 text-xs bg-[var(--bg-base)] border border-slate-700 text-slate-300 hover:text-white hover:border-emerald-500 rounded-lg transition-colors">🛋️ Living Room</button>
    </div>
  </div>

  <!-- Room Input Rows -->
  <div class="mb-4">
    <div class="flex justify-between items-center mb-2">
      <label class="block text-sm text-slate-400">Rooms & Costs:</label>
      <button id="rc-add-row" class="text-xs px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-colors">+ Add Room</button>
    </div>
    <div id="rc-rows" class="space-y-2">
      <!-- Rooms inserted here -->
    </div>
  </div>

  <!-- Result -->
  <div id="rc-result" class="hidden bg-[var(--bg-base)] rounded-xl p-6 border border-slate-700">
    <div class="grid grid-cols-3 gap-4 text-center mb-4">
      <div>
        <div class="text-sm text-slate-400 mb-1">Materials</div>
        <div id="rc-materials" class="text-2xl font-bold" style="color:#10b981"></div>
      </div>
      <div>
        <div class="text-sm text-slate-400 mb-1">Labor</div>
        <div id="rc-labor" class="text-2xl font-bold text-slate-300"></div>
      </div>
      <div>
        <div class="text-sm text-slate-400 mb-1">Total Budget</div>
        <div id="rc-total" class="text-2xl font-bold text-amber-400"></div>
      </div>
    </div>
    <div class="text-xs text-slate-500 text-center mb-3">
      <span id="rc-rooms-count">0</span> rooms · <span id="rc-room-list"></span>
    </div>
    <button id="rc-copy" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition-colors">Copy Budget</button>
  </div>

  <!-- Info -->
  <div class="mt-6 p-4 bg-emerald-950/40 rounded-lg border border-emerald-800/40 text-sm">
    <p class="font-medium mb-2 text-emerald-200">How it works:</p>
    <p class="text-emerald-100">Total Budget = (Materials + Labor) for each room</p>
    <p class="mt-2 text-xs text-emerald-100/90">Example: Kitchen materials ₹1,50,000 + labor ₹50,000 = ₹2,00,000 | Bathroom ₹80,000 + ₹30,000 = ₹1,10,000</p>
  </div>
</div>

<script is:inline>
(function() {
  let rooms = [];
  let roomId = 0;

  const presets = {
    kitchen: [
      { room: 'Kitchen', materials: 150000, labor: 50000 }
    ],
    bathroom: [
      { room: 'Bathroom', materials: 80000, labor: 30000 }
    ],
    bedroom: [
      { room: 'Master Bedroom', materials: 60000, labor: 20000 },
      { room: 'Guest Bedroom', materials: 40000, labor: 15000 }
    ],
    living: [
      { room: 'Living Room', materials: 100000, labor: 40000 },
      { room: 'Dining Area', materials: 70000, labor: 25000 }
    ]
  };

  function createRoom(name = '', materials = '', labor = '', id = null) {
    id = id !== null ? id : roomId++;
    const room = { id, name, materials, labor };
    rooms.push(room);

    const html = `
      <div class="flex gap-2 items-end" data-room-id="${id}">
        <div class="flex-1">
          <label class="block text-xs text-slate-500 mb-1">Room Name</label>
          <input type="text" placeholder="e.g. Kitchen" data-name class="w-full bg-[var(--bg-base)] border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-emerald-500" value="${name}" />
        </div>
        <div class="flex-1">
          <label class="block text-xs text-slate-500 mb-1">Materials (₹)</label>
          <input type="number" placeholder="e.g. 100000" data-materials class="w-full bg-[var(--bg-base)] border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-emerald-500" value="${materials}" />
        </div>
        <div class="flex-1">
          <label class="block text-xs text-slate-500 mb-1">Labor (₹)</label>
          <input type="number" placeholder="e.g. 30000" data-labor class="w-full bg-[var(--bg-base)] border border-slate-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-emerald-500" value="${labor}" />
        </div>
        <button data-remove-room class="px-3 py-2 bg-red-900/20 hover:bg-red-900/40 text-red-400 rounded-lg text-sm transition-colors shrink-0">✕</button>
      </div>
    `;

    const rowsContainer = document.getElementById('rc-rows');
    const div = document.createElement('div');
    div.innerHTML = html;
    rowsContainer.appendChild(div.firstElementChild);

    attachRoomListeners(id);
  }

  function attachRoomListeners(id) {
    const rowEl = document.querySelector(`[data-room-id="${id}"]`);
    if (!rowEl) return;

    rowEl.querySelector('[data-name]').addEventListener('input', (e) => {
      const room = rooms.find(r => r.id === id);
      if (room) room.name = e.target.value;
      calculate();
    });

    rowEl.querySelector('[data-materials]').addEventListener('input', (e) => {
      const room = rooms.find(r => r.id === id);
      if (room) room.materials = e.target.value;
      calculate();
    });

    rowEl.querySelector('[data-labor]').addEventListener('input', (e) => {
      const room = rooms.find(r => r.id === id);
      if (room) room.labor = e.target.value;
      calculate();
    });

    rowEl.querySelector('[data-remove-room]').addEventListener('click', () => {
      rooms = rooms.filter(r => r.id !== id);
      rowEl.remove();
      calculate();
    });
  }

  function calculate() {
    const validRooms = rooms.filter(r => r.name && r.materials && r.labor);
    if (validRooms.length === 0) {
      document.getElementById('rc-result').classList.add('hidden');
      return;
    }

    const totalMaterials = validRooms.reduce((sum, r) => sum + parseFloat(r.materials), 0);
    const totalLabor = validRooms.reduce((sum, r) => sum + parseFloat(r.labor), 0);
    const total = totalMaterials + totalLabor;

    document.getElementById('rc-materials').textContent = '₹' + totalMaterials.toLocaleString(undefined, {maximumFractionDigits: 0});
    document.getElementById('rc-labor').textContent = '₹' + totalLabor.toLocaleString(undefined, {maximumFractionDigits: 0});
    document.getElementById('rc-total').textContent = '₹' + total.toLocaleString(undefined, {maximumFractionDigits: 0});
    document.getElementById('rc-rooms-count').textContent = validRooms.length;
    document.getElementById('rc-room-list').textContent = validRooms.map(r => r.name).join(', ');
    document.getElementById('rc-result').classList.remove('hidden');
  }

  function loadPreset(presetName) {
    rooms = [];
    document.getElementById('rc-rows').innerHTML = '';
    roomId = 0;
    presets[presetName].forEach(p => createRoom(p.room, p.materials, p.labor));
    calculate();
  }

  document.querySelectorAll('[data-preset]').forEach(btn => {
    btn.addEventListener('click', () => loadPreset(btn.dataset.preset));
  });

  document.getElementById('rc-add-row').addEventListener('click', () => createRoom());

  document.getElementById('rc-copy').addEventListener('click', () => {
    const total = document.getElementById('rc-total').textContent;
    navigator.clipboard.writeText(total).then(() => {
      const btn = document.getElementById('rc-copy');
      const orig = btn.textContent;
      btn.textContent = '✓ Copied!';
      setTimeout(() => btn.textContent = orig, 2000);
    });
  });

  createRoom();
  createRoom();
})();
</script>
