---
---
<div class="space-y-5">
  <div id="blur-drop" class="border-2 border-dashed border-slate-700 rounded-xl p-8 text-center cursor-pointer hover:border-amber-500/60 transition-colors">
    <input id="blur-file" type="file" accept="image/*" class="hidden" />
    <div class="text-3xl mb-2">🤐</div>
    <p class="text-slate-300 font-medium">Drop an image here or <span class="text-amber-400 underline cursor-pointer">click to browse</span></p>
    <p class="text-slate-500 text-xs mt-1">Detect and blur faces — no upload, runs in your browser</p>
  </div>

  <div id="blur-panel" class="hidden space-y-4">
    <!-- Preview -->
    <div class="rounded-xl border border-slate-700 bg-[var(--bg-surface-hover)] p-3 text-center overflow-hidden" style="max-height:400px;">
      <canvas id="blur-canvas" class="max-w-full max-h-96 mx-auto border border-slate-700 rounded-lg"></canvas>
    </div>

    <!-- Status -->
    <div id="blur-status" class="text-sm text-slate-400 text-center">Detecting faces...</div>

    <!-- Controls -->
    <div class="space-y-3">
      <div>
        <div class="flex justify-between text-xs text-slate-400 mb-1">
          <label>Blur intensity</label>
          <span id="blur-intensity-val" class="text-amber-400">15px</span>
        </div>
        <input id="blur-intensity" type="range" min="5" max="50" value="15" class="w-full accent-amber-500" />
      </div>
    </div>

    <div class="flex gap-2">
      <button id="blur-detect" class="flex-1 py-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg font-semibold text-sm transition-colors">
        Re-detect Faces
      </button>
      <button id="blur-download" class="flex-1 py-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg font-semibold text-sm transition-colors">
        Download
      </button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/tracking.js/1.9.3/tracking.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tracking.js/1.9.3/data/face.min.js"></script>

<script is:inline>
(function () {
  const drop = document.getElementById('blur-drop');
  const fileInput = document.getElementById('blur-file');
  const panel = document.getElementById('blur-panel');
  const canvas = document.getElementById('blur-canvas');
  const ctx = canvas.getContext('2d');
  const statusEl = document.getElementById('blur-status');
  const intensitySlider = document.getElementById('blur-intensity');
  const intensityVal = document.getElementById('blur-intensity-val');

  let img = null;
  let faces = [];
  let originalImageData = null;

  drop.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', (e) => {
    if (e.target.files[0]) loadImage(e.target.files[0]);
  });

  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('border-amber-400', 'bg-amber-950/20');
  });

  drop.addEventListener('dragleave', () => {
    drop.classList.remove('border-amber-400', 'bg-amber-950/20');
  });

  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('border-amber-400', 'bg-amber-950/20');
    if (e.dataTransfer.files[0]) loadImage(e.dataTransfer.files[0]);
  });

  function loadImage(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      img = new Image();
      img.onload = () => {
        canvas.width = img.width;
        canvas.height = img.height;
        drop.classList.add('hidden');
        panel.classList.remove('hidden');
        detectFaces();
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  function detectFaces() {
    statusEl.textContent = 'Detecting faces...';
    ctx.drawImage(img, 0, 0);

    const tracker = new tracking.ObjectTracker('face');
    tracker.setInitialScale(4);
    tracker.setStepSize(2);
    tracker.setEdgesDensity(0.1);

    tracking.track(canvas, tracker);
    faces = [];

    tracker.on('track', (e) => {
      faces = e.data;
      if (faces.length === 0) {
        statusEl.textContent = 'No faces detected. Try adjusting the image angle or lighting.';
      } else {
        statusEl.textContent = `${faces.length} face${faces.length > 1 ? 's' : ''} detected. Adjust blur and download.`;
      }
      redrawWithBlur();
    });
  }

  function redrawWithBlur() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0);

    const intensity = parseInt(intensitySlider.value);

    faces.forEach(face => {
      const { x, y, width, height } = face;
      blurRect(x, y, width, height, intensity);
    });
  }

  function blurRect(x, y, w, h, intensity) {
    const imageData = ctx.getImageData(x, y, w, h);
    const data = imageData.data;

    const pixelSize = Math.max(1, intensity / 3);
    for (let i = 0; i < w * h; i++) {
      const px = i % w;
      const py = Math.floor(i / w);

      if ((Math.floor(px / pixelSize) + Math.floor(py / pixelSize)) % 2 === 0) {
        const idx = i * 4;
        let r = 0, g = 0, b = 0, count = 0;

        for (let dy = -1; dy <= 1; dy++) {
          for (let dx = -1; dx <= 1; dx++) {
            const npx = px + dx;
            const npy = py + dy;
            if (npx >= 0 && npx < w && npy >= 0 && npy < h) {
              const nidx = (npy * w + npx) * 4;
              r += data[nidx];
              g += data[nidx + 1];
              b += data[nidx + 2];
              count++;
            }
          }
        }

        data[idx] = Math.round(r / count);
        data[idx + 1] = Math.round(g / count);
        data[idx + 2] = Math.round(b / count);
      }
    }

    ctx.putImageData(imageData, x, y);
  }

  intensitySlider.addEventListener('input', () => {
    intensityVal.textContent = intensitySlider.value + 'px';
    redrawWithBlur();
  });

  document.getElementById('blur-detect').addEventListener('click', detectFaces);

  document.getElementById('blur-download').addEventListener('click', () => {
    const link = document.createElement('a');
    link.href = canvas.toDataURL('image/jpeg', 0.95);
    link.download = 'blurred-faces.jpg';
    link.click();
  });
})();
</script>
