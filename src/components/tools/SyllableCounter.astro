---
---

<div class="space-y-4">
  <div>
    <div class="flex items-center justify-between mb-2">
      <label class="text-slate-300 text-sm font-medium">Input Text</label>
    </div>
    <textarea
      id="sc-input"
      rows="6"
      placeholder="Paste text or type here — syllables will be counted per word..."
      class="w-full bg-[var(--bg-base)] border border-slate-700 rounded-xl px-4 py-3 text-slate-100 placeholder-slate-600 resize-y outline-none focus:ring-2 focus:ring-violet-600 text-sm"
    ></textarea>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl px-4 py-3 text-center">
      <div id="sc-total" class="text-2xl font-bold text-violet-400">0</div>
      <div class="text-xs text-slate-500 mt-1">Total Syllables</div>
    </div>
    <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl px-4 py-3 text-center">
      <div id="sc-words" class="text-2xl font-bold text-slate-300">0</div>
      <div class="text-xs text-slate-500 mt-1">Words</div>
    </div>
    <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl px-4 py-3 text-center">
      <div id="sc-avg" class="text-2xl font-bold text-slate-300">0.0</div>
      <div class="text-xs text-slate-500 mt-1">Avg / Word</div>
    </div>
    <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl px-4 py-3 text-center">
      <div id="sc-poly" class="text-2xl font-bold text-slate-300">0</div>
      <div class="text-xs text-slate-500 mt-1">Polysyllabic (3+)</div>
    </div>
  </div>

  <div style="color: #0f172a; font-weight: bold; font-size: 1rem; margin-bottom: 0.75rem;" class="dark:text-white">Poetry Format Detector</div>
  <div class="rounded-xl p-4">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="bg-[var(--bg-base)] border border-slate-700 rounded-lg p-4 text-center">
        <div class="text-sm font-medium text-slate-300 mb-2">Haiku</div>
        <div class="text-xs text-slate-500 mb-2">(5-7-5)</div>
        <div id="sc-haiku" class="text-sm font-bold text-violet-400">–</div>
      </div>
      <div class="bg-[var(--bg-base)] border border-slate-700 rounded-lg p-4 text-center">
        <div class="text-sm font-medium text-slate-300 mb-2">Limerick</div>
        <div class="text-xs text-slate-500 mb-2">(8-8-5-5-8)</div>
        <div id="sc-limerick" class="text-sm font-bold text-violet-400">–</div>
      </div>
      <div class="bg-[var(--bg-base)] border border-slate-700 rounded-lg p-4 text-center">
        <div class="text-sm font-medium text-slate-300 mb-2">Sonnet</div>
        <div class="text-xs text-slate-500 mb-2">(10 per line)</div>
        <div id="sc-sonnet" class="text-sm font-bold text-violet-400">–</div>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <button id="sc-copy" class="bg-violet-700 hover:bg-violet-600 text-white font-medium px-5 py-2.5 rounded-xl transition-colors text-sm">Copy Results</button>
    <button id="sc-export-csv" class="bg-violet-700 hover:bg-violet-600 text-white font-medium px-4 py-2.5 rounded-xl transition-colors text-sm">CSV</button>
    <button id="sc-export-json" class="bg-violet-700 hover:bg-violet-600 text-white font-medium px-4 py-2.5 rounded-xl transition-colors text-sm">JSON</button>
    <button id="sc-clear" class="bg-violet-700 hover:bg-violet-600 text-white font-medium px-4 py-2.5 rounded-xl transition-colors text-sm">Clear</button>
  </div>

  <div id="sc-breakdown" class="space-y-1 max-h-60 overflow-y-auto"></div>

  <div style="color: #0f172a; font-weight: bold; font-size: 1rem; margin-bottom: 0.75rem;" class="dark:text-white">How Syllable Counting Works</div>
  <div class="rounded-xl p-4">
    <ul class="text-sm text-slate-300 space-y-2">
      <li class="flex gap-2"><span class="text-violet-400 font-bold">•</span> <span><strong>Vowel groups:</strong> Each vowel cluster = 1 syllable</span></li>
      <li class="flex gap-2"><span class="text-violet-400 font-bold">•</span> <span><strong>Silent e:</strong> Words ending in 'e' usually don't add a syllable</span></li>
      <li class="flex gap-2"><span class="text-violet-400 font-bold">•</span> <span><strong>Consonant + y:</strong> 'y' between consonants acts as a vowel</span></li>
      <li class="flex gap-2"><span class="text-violet-400 font-bold">•</span> <span><strong>Exception:</strong> Single-syllable words (3 letters or less) count as 1</span></li>
    </ul>
  </div>
</div>

<script>
function countSyllables(word) {
  word = word.toLowerCase().replace(/[^a-z]/g, '');
  if (!word) return 0;
  if (word.length <= 3) return 1;
  word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '');
  word = word.replace(/^y/, '');
  const m = word.match(/[aeiouy]{1,2}/g);
  return m ? m.length : 1;
}

function getSyllableColor(s) {
  if (s === 1) return 'bg-blue-900/40 border-blue-700';
  if (s === 2) return 'bg-purple-900/40 border-purple-700';
  if (s >= 3) return 'bg-orange-900/40 border-orange-700';
  return 'bg-slate-700/40 border-slate-600';
}

let currentBreakdown = [];

function count() {
  const text = document.getElementById('sc-input').value;
  const lines = text.split('\n').filter(l => l.trim());
  const words = text.match(/[a-zA-Z']+/g) || [];
  let total = 0, poly = 0;

  currentBreakdown = words.map(w => {
    const s = countSyllables(w);
    total += s;
    if (s >= 3) poly++;
    return { w, s };
  });

  document.getElementById('sc-total').textContent = total;
  document.getElementById('sc-words').textContent = words.length;
  document.getElementById('sc-avg').textContent = words.length ? (total / words.length).toFixed(1) : '0.0';
  document.getElementById('sc-poly').textContent = poly;

  // Poetry validators
  const lineSyllables = lines.map(line => (line.match(/[a-zA-Z']+/g) || []).reduce((sum, w) => sum + countSyllables(w), 0));
  const isHaiku = lineSyllables.length === 3 && lineSyllables[0] === 5 && lineSyllables[1] === 7 && lineSyllables[2] === 5;
  const isLimerick = lineSyllables.length === 5 && lineSyllables[0] === 8 && lineSyllables[1] === 8 && lineSyllables[2] === 5 && lineSyllables[3] === 5 && lineSyllables[4] === 8;
  const isSonnet = lineSyllables.length === 14 && lineSyllables.every(s => s === 10);

  document.getElementById('sc-haiku').textContent = isHaiku ? '✅ Valid!' : '❌ Not a haiku';
  document.getElementById('sc-limerick').textContent = isLimerick ? '✅ Valid!' : '❌ Not a limerick';
  document.getElementById('sc-sonnet').textContent = isSonnet ? '✅ Valid!' : '❌ Not a sonnet';

  // Breakdown display
  const bd = document.getElementById('sc-breakdown');
  if (currentBreakdown.length === 0) {
    bd.innerHTML = '<p class="text-xs text-slate-500">Enter text to see word-by-word breakdown</p>';
    return;
  }

  bd.innerHTML = '<p class="text-xs text-slate-500 mb-2">Syllable count per word:</p>' +
    '<div class="flex flex-wrap gap-1.5">' +
    currentBreakdown.map(({w,s}) =>
      `<span class="bg-[var(--bg-surface)] border ${getSyllableColor(s)} rounded-lg px-2 py-0.5 text-xs text-slate-200">${w} <span class="text-violet-400">${s}</span></span>`
    ).join('') + '</div>';
}

// Event listeners
document.getElementById('sc-input').addEventListener('input', count);

document.getElementById('sc-copy').addEventListener('click', () => {
  if (currentBreakdown.length === 0) return;
  const text = currentBreakdown.map(({w,s}) => `${w}: ${s}`).join('\n');
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('sc-copy');
    const orig = btn.textContent;
    btn.textContent = '✅ Copied!';
    setTimeout(() => btn.textContent = orig, 2000);
  });
});

document.getElementById('sc-export-csv').addEventListener('click', () => {
  if (currentBreakdown.length === 0) return;
  const csv = 'Word,Syllables\n' + currentBreakdown.map(({w,s}) => `${w},${s}`).join('\n');
  const blob = new Blob([csv], {type: 'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'syllables.csv';
  a.click();
});

document.getElementById('sc-export-json').addEventListener('click', () => {
  if (currentBreakdown.length === 0) return;
  const json = JSON.stringify({
    total_syllables: currentBreakdown.reduce((sum, {s}) => sum + s, 0),
    total_words: currentBreakdown.length,
    words: currentBreakdown
  }, null, 2);
  const blob = new Blob([json], {type: 'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'syllables.json';
  a.click();
});

document.getElementById('sc-clear').addEventListener('click', () => {
  document.getElementById('sc-input').value = '';
  count();
});
</script>
