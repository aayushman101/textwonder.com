---
import BaseLayout from './BaseLayout.astro';
import { alternatesForTool } from '../i18n/index.js';
import PDFHeader from '../components/PDFHeader.astro';
import Footer from '../components/Footer.astro';

const { tool } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.name,
  url: `https://textwonder.com/pdfwonder/${tool.slug}/`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  description: tool.metaDescription,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  provider: { '@type': 'Organization', name: 'TextWonder', url: 'https://textwonder.com' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://textwonder.com' },
    { '@type': 'ListItem', position: 2, name: 'PDFWonder', item: 'https://textwonder.com/pdfwonder/' },
    { '@type': 'ListItem', position: 3, name: tool.name, item: `https://textwonder.com/pdfwonder/${tool.slug}/` },
  ],
};

const faqSchema = (tool.faqs && tool.faqs.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faqs.map((f: { q: string; a: string }) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
// hreflang cluster — the English page must list every translated version,
// otherwise Google discards the whole cluster as one-directional.
const alternates = alternatesForTool('pdfwonder', tool.slug);

---

<BaseLayout
  title={tool.metaTitle}
  description={tool.metaDescription}
  canonical={`/pdfwonder/${tool.slug}/`}
  alternates={alternates}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <PDFHeader alternates={alternates} />

  <!-- Wide container. `max-width` only binds once the viewport exceeds it, so
       everything below `lg` is byte-for-byte what it was: phones and tablets
       already rendered at 100% width and are untouched by this. The gain is
       entirely on laptops and desktops, which previously used 62% and 47% of
       the screen.

       Prose does NOT inherit the full width - long measure is harder to read,
       not easier. Instead the three description blocks become columns at `lg`,
       so each one lands near 60ch while the row as a whole fills the screen. -->
  <main class="w-full max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1 text-sm text-slate-500 mb-6">
      <a href="/pdfwonder/" class="hover:text-orange-400 transition-colors">PDFWonder</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-slate-300">{tool.name}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-2" style="font-family: 'Space Grotesk', sans-serif;">
      {tool.h1}
    </h1>
    <p class="text-slate-400 text-lg mb-8">{tool.tagline}</p>

    <!-- Tool UI -->
    <div class="bg-[var(--bg-surface)] border border-slate-800 rounded-2xl p-6 mb-10">
      <slot />
    </div>

    <!-- SEO Content — stacked on small screens, three columns from `lg` so the
         width is used without stretching any single paragraph past a
         comfortable measure. -->
    <section class="mb-10 grid gap-6 lg:grid-cols-3 lg:gap-10">
      <div>
        <h2 class="text-xl font-semibold text-white mb-2">About {tool.name}</h2>
        <p class="text-slate-400 leading-relaxed">{tool.descriptionLong}</p>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white mb-2">Use Cases</h2>
        <p class="text-slate-400 leading-relaxed">{tool.useCases}</p>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white mb-2">How It Works</h2>
        <p class="text-slate-400 leading-relaxed">{tool.howItWorks}</p>
      </div>
    </section>

    <!-- FAQ -->
    {tool.faqs && tool.faqs.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-white mb-4">FAQs</h2>
        <div class="grid gap-2 lg:grid-cols-2 lg:gap-x-6 lg:items-start">
          {tool.faqs.map((faq: { q: string; a: string }) => (
            <details class="bg-[var(--bg-surface)] border border-slate-800 rounded-xl group">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none hover:bg-[var(--bg-surface-hover)] rounded-xl transition-colors">
                <span class="text-white font-medium text-sm">{faq.q}</span>
                <svg class="w-4 h-4 text-slate-400 shrink-0 ml-2 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-5 pb-4"><p class="text-slate-400 text-sm leading-relaxed">{faq.a}</p></div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related tools -->
    <section>
      <h2 class="text-xl font-semibold text-white mb-4">Related PDF Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3">
        {tool.relatedTools.map((slug: string) => {
          const { PDF_TOOLS } = Astro.glob ? {} : { PDF_TOOLS: [] };
          return (
            <a href={`/pdfwonder/${slug}/`} class="group block bg-[var(--bg-surface)] border border-slate-800 rounded-xl p-4 hover:border-orange-500/50 hover:bg-[var(--bg-surface-hover)] transition-all">
              <span class="text-white text-sm font-medium group-hover:text-orange-400 transition-colors block">{slug.replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase())}</span>
              <svg class="w-4 h-4 text-slate-600 group-hover:text-orange-400 transition-colors mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          );
        })}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
