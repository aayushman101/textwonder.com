const faqs = [
  { q: 'What is the weighted average formula?', a: 'Weighted Average = (Sum of Value × Weight) ÷ Sum of Weights. For example: (100×100 + 120×50) ÷ (100+50) = ₹106.67' },
  { q: 'How do I calculate weighted average for stocks?', a: 'Enter each purchase price as the "Value" and the number of shares as the "Weight". The result is your average cost per share. Example: 100 shares at ₹50 + 200 shares at ₹60 = weighted average ₹56.67 per share.' },
  { q: 'How is weighted average used for grades?', a: 'Assign each exam/assignment its score as "Value" and its credit hours or weight as "Weight". For example: midterm (85, weight 30) + quiz (78, weight 20) + final (92, weight 50) = weighted average 85.6.' },
  { q: 'What is the difference between weighted and simple average?', a: 'Simple average treats all values equally. Weighted average lets each value have different importance. If you bought 100 shares at ₹100 and 1 share at ₹500, simple average = ₹300 but weighted average = ₹100.99.' },
  { q: 'Can I use this for payroll calculations?', a: 'Yes. If you have different employee salaries across departments, enter salary as Value and number of employees as Weight to find the weighted average salary.' },
  { q: 'Can I calculate weighted average in Excel?', a: 'Yes, use the formula =SUMPRODUCT(values, weights)/SUM(weights). The online calculator provides instant results without needing Excel.' },
  { q: 'What if all weights are the same?', a: 'If all weights are identical, the weighted average equals the simple average.' },
];
