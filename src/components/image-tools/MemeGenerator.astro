---
---
<div class="space-y-5">
  <div id="meme-drop" class="border-2 border-dashed border-slate-700 rounded-xl p-8 text-center cursor-pointer hover:border-indigo-500/60 transition-colors">
    <input id="meme-file" type="file" accept="image/*" class="hidden" />
    <div class="text-3xl mb-2">😂</div>
    <p class="text-slate-300 font-medium">Drop an image here or <span class="text-indigo-400 underline cursor-pointer">click to browse</span></p>
    <p class="text-slate-500 text-xs mt-1">Add top/bottom meme text — no upload, runs in your browser</p>
  </div>

  <div id="meme-panel" class="hidden space-y-4">
    <!-- Preview -->
    <div class="rounded-xl border border-slate-700 bg-[var(--bg-surface-hover)] p-3 text-center overflow-hidden">
      <canvas id="meme-canvas" class="max-w-full max-h-96 mx-auto border border-slate-700 rounded-lg"></canvas>
    </div>

    <!-- Controls -->
    <div class="space-y-3">
      <div>
        <label class="block text-xs text-slate-400 mb-1">Top text</label>
        <input id="meme-top" type="text" placeholder="Top text (e.g., WHEN YOU..."
          class="w-full bg-[var(--bg-surface-hover)] border border-slate-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" />
      </div>
      <div>
        <label class="block text-xs text-slate-400 mb-1">Bottom text</label>
        <input id="meme-bottom" type="text" placeholder="Bottom text (e.g., ...AND IT WORKS)"
          class="w-full bg-[var(--bg-surface-hover)] border border-slate-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs text-slate-400 mb-1">Text color</label>
          <input id="meme-color" type="color" value="#ffffff"
            class="w-full h-10 bg-[var(--bg-surface-hover)] border border-slate-700 rounded-lg cursor-pointer" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Outline color</label>
          <input id="meme-outline" type="color" value="#000000"
            class="w-full h-10 bg-[var(--bg-surface-hover)] border border-slate-700 rounded-lg cursor-pointer" />
        </div>
      </div>
      <div>
        <div class="flex justify-between text-xs text-slate-400 mb-1">
          <label>Font size</label>
          <span id="meme-size-val" class="text-indigo-400">50px</span>
        </div>
        <input id="meme-size" type="range" min="20" max="120" value="50" class="w-full accent-indigo-500" />
      </div>
    </div>

    <button id="meme-download" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg font-semibold text-sm transition-colors">
      Download Meme
    </button>
  </div>
</div>

<script is:inline>
(function () {
  const drop = document.getElementById('meme-drop');
  const fileInput = document.getElementById('meme-file');
  const panel = document.getElementById('meme-panel');
  const canvas = document.getElementById('meme-canvas');
  const ctx = canvas.getContext('2d');
  const topInput = document.getElementById('meme-top');
  const bottomInput = document.getElementById('meme-bottom');
  const colorInput = document.getElementById('meme-color');
  const outlineInput = document.getElementById('meme-outline');
  const sizeSlider = document.getElementById('meme-size');
  const sizeVal = document.getElementById('meme-size-val');

  let img = null;

  drop.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', (e) => {
    if (e.target.files[0]) loadImage(e.target.files[0]);
  });

  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('border-indigo-400', 'bg-indigo-950/20');
  });

  drop.addEventListener('dragleave', () => {
    drop.classList.remove('border-indigo-400', 'bg-indigo-950/20');
  });

  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('border-indigo-400', 'bg-indigo-950/20');
    if (e.dataTransfer.files[0]) loadImage(e.dataTransfer.files[0]);
  });

  function loadImage(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      img = new Image();
      img.onload = () => {
        canvas.width = img.width;
        canvas.height = img.height;
        drop.classList.add('hidden');
        panel.classList.remove('hidden');
        redraw();
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  function redraw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0);

    const fontSize = parseInt(sizeSlider.value);
    const textColor = colorInput.value;
    const outlineColor = outlineInput.value;
    const topText = topInput.value.toUpperCase();
    const bottomText = bottomInput.value.toUpperCase();

    ctx.font = `bold ${fontSize}px Impact, sans-serif`;
    ctx.textAlign = 'center';
    ctx.lineWidth = Math.max(3, fontSize / 15);
    ctx.strokeStyle = outlineColor;
    ctx.fillStyle = textColor;

    const y1 = fontSize + 20;
    const y2 = canvas.height - 20;

    ctx.strokeText(topText, canvas.width / 2, y1);
    ctx.fillText(topText, canvas.width / 2, y1);
    ctx.strokeText(bottomText, canvas.width / 2, y2);
    ctx.fillText(bottomText, canvas.width / 2, y2);
  }

  topInput.addEventListener('input', redraw);
  bottomInput.addEventListener('input', redraw);
  colorInput.addEventListener('input', redraw);
  outlineInput.addEventListener('input', redraw);
  sizeSlider.addEventListener('input', () => {
    sizeVal.textContent = sizeSlider.value + 'px';
    redraw();
  });

  document.getElementById('meme-download').addEventListener('click', () => {
    const link = document.createElement('a');
    link.href = canvas.toDataURL('image/jpeg', 0.95);
    link.download = 'meme.jpg';
    link.click();
  });
})();
</script>
