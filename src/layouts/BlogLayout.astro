---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  date: string;
  readTime: string;
  category: string;
  faqs?: Array<{ q: string; a: string }>;
}

const { title, description, canonical, date, readTime, category, faqs = [] } = Astro.props;
const siteUrl = 'https://textwonder.com';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: `${siteUrl}${canonical}`,
  datePublished: date,
  dateModified: date,
  author: { '@type': 'Organization', name: 'TextWonder', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'TextWonder', url: siteUrl, logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}${canonical}` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: `${siteUrl}${canonical}` },
  ],
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const dateObj = new Date(date);
const displayDate = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={date} />
  </Fragment>

  <Header />

  <main class="max-w-3xl mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1 text-sm text-slate-500 mb-8">
      <a href="/" class="hover:text-violet-400 transition-colors">Home</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href="/blog/" class="hover:text-violet-400 transition-colors">Blog</a>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-slate-400 truncate max-w-[200px]">{title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-violet-900/40 text-violet-300 border border-violet-800/50">{category}</span>
        <span class="text-slate-600 text-xs">·</span>
        <span class="text-slate-500 text-xs">{readTime}</span>
        <span class="text-slate-600 text-xs">·</span>
        <time datetime={date} class="text-slate-500 text-xs">{displayDate}</time>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-4" style="font-family: 'Space Grotesk', sans-serif;">{title}</h1>
      <p class="text-slate-400 text-lg leading-relaxed">{description}</p>
    </header>

    <!-- Ad Slot #1: After Blog Header -->
    <div class="mb-10">
      <AdSlot slot="5678901234" format="rectangle" />
    </div>

    <!-- Article content -->
    <article class="blog-article">
      <slot />
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Typography for slotted blog copy lives in src/styles/global.css under
     .blog-article — Astro-scoped rules cannot reach <slot /> content.
     Only the CTA and FAQ blocks are styled here, via :global(). */
  :global(.tool-cta) { display: block; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 16%, var(--bg-surface)), color-mix(in srgb, var(--accent) 30%, var(--bg-surface))); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); border-radius: 1rem; padding: 1.5rem; margin: 2.5rem 0; text-decoration: none !important; transition: all 0.2s; }
  :global(.tool-cta:hover) { border-color: color-mix(in srgb, var(--accent) 60%, transparent); box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 22%, transparent); }
  :global(.tool-cta .cta-label) { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #c4b5fd; font-weight: 600; margin-bottom: 0.25rem; }
  :global(.tool-cta .cta-title) { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 0.25rem; font-family: 'Space Grotesk', sans-serif; }
  :global(.tool-cta .cta-desc) { font-size: 0.875rem; color: #ddd6fe; }
  :global(.faq-section) { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid rgba(148,163,184,0.16); }
  :global(.faq-section h2) { border-bottom: 0; padding-bottom: 0; margin-top: 0; }
  :global([data-theme="light"] .faq-section) { border-top-color: #e2e8f0; }
</style>
